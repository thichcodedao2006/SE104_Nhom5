<Window x:Class="QLTB.fmDangNhap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Đăng nhập hệ thống"
        Width="1180"
        Height="720"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        MouseDown="Window_MouseDown">
    <Window.Resources>
        <LinearGradientBrush x:Key="MainBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EDF4FF" Offset="0"/>
            <GradientStop Color="#DCE9FF" Offset="0.55"/>
            <GradientStop Color="#F8FBFF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0E67C8" Offset="0"/>
            <GradientStop Color="#164DA8" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PanelBrush" Color="#FCFDFF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InputBrush" Color="#F9FBFF"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#BCD0F4"/>
        <SolidColorBrush x:Key="InputFocusBrush" Color="#0F6BCD"/>
        <SolidColorBrush x:Key="TitleBrush" Color="#14213D"/>
        <SolidColorBrush x:Key="BodyBrush" Color="#4B5568"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6E7C93"/>
        <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#145CC6"/>
        <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#0F4CA8"/>
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#EAF1FF"/>
        <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#DCE8FF"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F3F7FF"/>

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="24"
                          ShadowDepth="0"
                          Opacity="0.18"
                          Color="#15315D"/>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TitleBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="InputShellStyle" TargetType="Border">
            <Setter Property="Height" Value="58"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource InputFocusBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlainTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#10233E"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="#8DB7FF"/>
        </Style>

        <Style x:Key="PlainPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#10233E"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryButtonHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Foreground" Value="#174EA6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource SecondaryButtonBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SecondaryButtonHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#EAF1FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource MainBackgroundBrush}">
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="360"
                     Height="360"
                     Canvas.Left="-90"
                     Canvas.Top="-110"
                     Fill="#35FFFFFF"/>
            <Ellipse Width="300"
                     Height="300"
                     Canvas.Right="-70"
                     Canvas.Bottom="-80"
                     Fill="#2A9EC5FF"/>
        </Canvas>

        <Border Width="1080"
                Height="610"
                Padding="0"
                Background="{StaticResource CardBrush}"
                CornerRadius="30"
                Effect="{StaticResource CardShadow}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.03*"/>
                    <ColumnDefinition Width="0.97*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource HeroBrush}"
                        CornerRadius="30,0,0,30">
                    <Grid ClipToBounds="True">
                        <Ellipse Width="280"
                                 Height="280"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,-120,-80,0"
                                 Fill="#18FFFFFF"/>
                        <Ellipse Width="220"
                                 Height="220"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Bottom"
                                 Margin="-90,0,0,-110"
                                 Fill="#12FFFFFF"/>

                        <Grid Margin="44">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <Border Width="74"
                                        Height="74"
                                        CornerRadius="22"
                                        Background="#24FFFFFF"
                                        HorizontalAlignment="Left">
                                    <Viewbox Margin="20">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="White"
                                                  Data="M12,2A3.25,3.25 0 1 1 8.75,5.25A3.25,3.25 0 0 1 12,2M6,10A4,4 0 1 1 2,14A4,4 0 0 1 6,10M18,10A4,4 0 1 1 14,14A4,4 0 0 1 18,10M12,11C15.87,11 19,13.24 19,16V19H5V16C5,13.24 8.13,11 12,11Z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>

                                <TextBlock Margin="0,10,0,0"
                                           FontFamily="Bahnschrift"
                                           FontSize="36"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Text="Quản lý thiết bị" Height="43"/>
                                <TextBlock Margin="0,16,10,0"
                                           FontSize="17"
                                           Foreground="#E5F0FF"
                                           TextWrapping="Wrap"
                                           LineHeight="26"
                                           Text="Không gian làm việc sáng sủa, rõ ràng để bạn đăng nhập nhanh và bắt đầu quản lý thiết bị ngay." Height="53" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleY="1"/>
                                            <SkewTransform/>
                                            <RotateTransform/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        VerticalAlignment="Center">
                                <Border Margin="0,0,0,14"
                                        Padding="18"
                                        CornerRadius="22"
                                        Background="#1CFFFFFF"
                                        BorderBrush="#26FFFFFF"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   Text="Bố cục dễ dùng"/>
                                        <TextBlock Margin="0,8,0,0"
                                                   FontSize="13"
                                                   Foreground="#E2ECFF"
                                                   TextWrapping="Wrap"
                                                   Text="Tài khoản, mật khẩu và ghi nhớ đăng nhập được chia tách rõ ràng, dễ quan sát."/>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,14"
                                        Padding="18"
                                        CornerRadius="22"
                                        Background="#1CFFFFFF"
                                        BorderBrush="#26FFFFFF"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   Text="Phong cách hiện đại"/>
                                        <TextBlock Margin="0,8,0,0"
                                                   FontSize="13"
                                                   Foreground="#E2ECFF"
                                                   TextWrapping="Wrap"
                                                   Text="Nền sáng, khối bo tròn và điểm nhấn xanh giúp giao diện gọn mà vẫn chuyên nghiệp."/>
                                    </StackPanel>
                                </Border>

                                <Border Padding="18"
                                        CornerRadius="22"
                                        Background="#1CFFFFFF"
                                        BorderBrush="#26FFFFFF"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   Text="Sẵn sàng mở rộng"/>
                                        <TextBlock Margin="0,8,0,0"
                                                   FontSize="13"
                                                   Foreground="#E2ECFF"
                                                   TextWrapping="Wrap"
                                                   Text="Có thể nối đăng nhập thật, kiểm tra dữ liệu hoặc binding sang ViewModel bất cứ lúc nào."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Row="2"
                                       FontSize="13"
                                       Foreground="#DCE9FF"
                                       Text="QLTB Workspace | Smart Equipment Management" Margin="0,0,0,-37"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid Margin="46,42,46,34">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#0F6BCD"
                                       Text="Welcome back"/>
                            <TextBlock Margin="0,10,0,0"
                                       FontFamily="Bahnschrift"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TitleBrush}"
                                       Text="Đăng nhập tài khoản"/>
                            <TextBlock Margin="0,12,0,0"
                                       FontSize="14"
                                       Foreground="{StaticResource BodyBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="22"
                                       Text="Nhập thông tin để truy cập hệ thống quản lý thiết bị."/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Margin="0,30,0,24">
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Tên đăng nhập"/>
                                <Border Style="{StaticResource InputShellStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="30"
                                                Height="30"
                                                Background="#E5EEFF"
                                                CornerRadius="10"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Path Width="14"
                                                  Height="14"
                                                  Stretch="Uniform"
                                                  Fill="#145CC6"
                                                  Data="M12,12A4,4 0 1 0 8,8A4,4 0 0 0 12,12M12,14C8.13,14 5,16.13 5,18.75V20H19V18.75C19,16.13 15.87,14 12,14Z"/>
                                        </Border>

                                        <TextBox Grid.Column="1"
                                                 x:Name="txtTenDangNhap"
                                                 Margin="0,0,16,0"
                                                 Style="{StaticResource PlainTextBoxStyle}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="Mật khẩu"/>
                                <Border Style="{StaticResource InputShellStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="30"
                                                Height="30"
                                                Background="#E5EEFF"
                                                CornerRadius="10"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Path Width="14"
                                                  Height="14"
                                                  Stretch="Uniform"
                                                  Fill="#145CC6"
                                                  Data="M12,1A4,4 0 0 0 8,5V7H7A2,2 0 0 0 5,9V18A2,2 0 0 0 7,20H17A2,2 0 0 0 19,18V9A2,2 0 0 0 17,7H16V5A4,4 0 0 0 12,1M10,5A2,2 0 0 1 14,5V7H10Z"/>
                                        </Border>

                                        <PasswordBox Grid.Column="1"
                                                     x:Name="txtMatKhau"
                                                     Margin="0,0,16,0"
                                                     Style="{StaticResource PlainPasswordBoxStyle}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox VerticalAlignment="Center"
                                          Foreground="{StaticResource BodyBrush}"
                                          Content="Ghi nhớ đăng nhập"/>

                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="#145CC6">
                                            <Hyperlink Click="QuenMatKhau_Click">Quên mật khẩu?</Hyperlink>
                                </TextBlock>

                            </Grid>

                            <Button x:Name="btn_DangNhap" Margin="0,24,0,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Đăng nhập" Click="btn_DangNhap_Click"
                                    IsDefault="True"/>


                        </StackPanel>

                        <Button Grid.Row="1"
                                HorizontalAlignment="Center"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Đăng ký tài khoản mới" Click="btnDangKy_Click" Margin="0,351,0,30" Width="432"/>
                    </Grid>
                </Grid>

                <StackPanel Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,16,18,0">
                    <Button Style="{StaticResource WindowButtonStyle}"
                            Click="BtnMinimize_Click"
                            ToolTip="Thu nhỏ">
                        <Path Data="M0 0 H12"
                              Stroke="#174EA6"
                              StrokeThickness="2"
                              Stretch="Uniform"/>
                    </Button>
                    <Button Margin="8,0,0,0"
                            Style="{StaticResource WindowButtonStyle}"
                            Background="#F06644"
                            Click="BtnClose_Click"
                            ToolTip="Đóng">
                        <Path Data="M3 3 L9 9 M9 3 L3 9"
                              Stroke="White"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
