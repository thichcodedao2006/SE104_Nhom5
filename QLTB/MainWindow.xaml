<Window x:Class="QLTB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QLTB"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:vm="clr-namespace:QLTB.ViewModel"
        xmlns:view="clr-namespace:QLTB.UserControlFolder.DashBoard"
        xmlns:device="clr-namespace:QLTB.UserControlFolder.Device"
        xmlns:material="clr-namespace:QLTB.UserControlFolder.Material"
        xmlns:employee="clr-namespace:QLTB.UserControlFolder.Employee"
        xmlns:maintenance="clr-namespace:QLTB.UserControlFolder.Maintenance"
         Height="900"
         Width="1280"
         WindowState="Maximized"
         WindowStartupLocation="CenterScreen"
         ResizeMode="CanResize" 
         FontFamily="Segoe UI"
         Background="#F8FAFC">
    <Window.Resources>
    <DataTemplate DataType="{x:Type vm:DashBoardViewModel}">
        <view:DashBoardView/>
    </DataTemplate>

      <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
            <device:DeviceView/>
      </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MaterialViewModel}">
        <material:MaterialView/>
        </DataTemplate>
        

        <DataTemplate DataType="{x:Type vm:EmployeeViewModel}">
            <employee:EmployeeView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MaintenancePlanViewModel}">
            <maintenance:MaintenancePlan/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MaintenanceTaskViewModel}">
            <maintenance:MaintenanceTask/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MaintenanceHistoryViewModel}">
            <maintenance:MaintenanceHistoryView/>
        </DataTemplate>

        <!-- Active Sidebar Button -->
    <Style x:Key="SidebarButtonActive"
            TargetType="Button"
            BasedOn="{StaticResource SidebarButton}">
        <Setter Property="Background" Value="#EFF6FF"/>
        <Setter Property="Foreground" Value="#2563EB"/>
    </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
             Background="White"
             BorderBrush="#E5E7EB"
             BorderThickness="0 0 1 0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0"
                         Orientation="Horizontal"
                         VerticalAlignment="Center"
                         Margin="26 0 0 0">

                    <Border Width="34"
                         Height="34"
                         Background="#2563EB"
                         CornerRadius="9">
                        <fa:ImageAwesome Icon="Archive"
                                      Width="16"
                                      Height="16"
                                      Foreground="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Quản lý bảo trì"
                            Margin="12 0 0 0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#111827"/>
                </StackPanel>

                <!-- Menu -->
                <StackPanel Grid.Row="1" Margin="0 12 0 0">

                    <Button Style="{StaticResource SidebarButtonActive}"
                        Command="{Binding OpenDashboardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="ThLarge"
                                          Width="16"
                                          Height="16"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Margin="0 0 12 0"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}"
                     Command="{Binding OpenEmployeeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Users"
                                          Width="16"
                                          Height="16"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Margin="0 0 12 0"/>
                            <TextBlock Text="Nhân viên bảo trì"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}"
                         Command="{Binding OpenDeviceCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Archive"
                                          Width="16"
                                          Height="16"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Margin="0 0 12 0"/>
                            <TextBlock Text="Thiết bị"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}"
                         Command="{Binding OpenMaterialCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Cube"
                                          Width="16"
                                          Height="16"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Margin="0 0 12 0"/>
                            <TextBlock Text="Vật tư"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}"
                            Command="{Binding OpenMaintenancePlanCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Calendar"
                                          Width="16"
                                          Height="16"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Margin="0 0 12 0"/>
                            <TextBlock Text="Kế hoạch bảo trì"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}"
                            Command="{Binding OpenMaintenanceTaskCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="ListAlt"
                                          Width="16"
                                          Height="16"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Margin="0 0 12 0"/>
                            <TextBlock Text="Danh sách bảo trì cần làm"
                                    TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}"
                            Command="{Binding OpenMaintenanceHistoryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="History"
                                          Width="16"
                                          Height="16"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Margin="0 0 12 0"/>
                            <TextBlock Text="Lịch sử bảo trì"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="ExclamationTriangle"
                                          Width="16"
                                          Height="16"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Margin="0 0 12 0"/>
                            <TextBlock Text="Báo cáo sự cố"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="BarChart"
                                          Width="16"
                                          Height="16"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Margin="0 0 12 0"/>
                            <TextBlock Text="Thống kê"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Cog"
                                          Width="16"
                                          Height="16"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Margin="0 0 12 0"/>
                            <TextBlock Text="Cài đặt"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Column="1" Background="#F8FAFC">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOPBAR -->
            <Border Grid.Row="0"
                 Background="White"
                 BorderBrush="#E5E7EB"
                 BorderThickness="0 0 0 1">

                <Grid Margin="24 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <Border Width="470"
                         Height="42"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Background="White"
                         BorderBrush="#D1D5DB"
                         BorderThickness="1"
                         CornerRadius="9">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <fa:ImageAwesome Icon="Search"
                                          Width="16"
                                          Height="16"
                                          Foreground="#6B7280"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  VerticalContentAlignment="Center"
                                  FontSize="14"
                                  Foreground="#111827"
                                  Text="Tìm kiếm thiết bị, nhân viên, công việc..."/>
                        </Grid>
                    </Border>

                    <!-- Right user area -->
                    <StackPanel Grid.Column="1"
                             Orientation="Horizontal"
                             VerticalAlignment="Center">

                        <Grid Width="36" Height="36" Margin="0 0 18 0">
                            <fa:ImageAwesome Icon="BellOutline"
                                          Width="18"
                                          Height="18"
                                          Foreground="#6B7280"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                            <Ellipse Width="7"
                                  Height="7"
                                  Fill="#EF4444"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  Margin="0 7 6 0"/>
                        </Grid>

                        <Border Width="34"
                             Height="34"
                             Background="#2563EB"
                             CornerRadius="17"
                             Margin="0 0 10 0">
                            <TextBlock Text="NV"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Nguyễn Văn A"
                                    FontWeight="SemiBold"
                                    Foreground="#111827"/>
                            <TextBlock Text="Kỹ thuật viên"
                                    FontSize="12"
                                    Foreground="#6B7280"/>
                        </StackPanel>

                        <fa:ImageAwesome Icon="AngleDown"
                                      Width="12"
                                      Height="12"
                                      Foreground="#6B7280"
                                      Margin="14 0 0 0"
                                      VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <ScrollViewer Grid.Row="1"
                       VerticalScrollBarVisibility="Auto">
                <ContentControl Margin="24"
                             Content="{Binding CurrentViewModel}"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
