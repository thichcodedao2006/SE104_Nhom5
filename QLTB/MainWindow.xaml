<Window x:Class="QLTB.MainWindow"
        x:Name="thisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QLTB"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        xmlns:vm="clr-namespace:QLTB.ViewModel"
        xmlns:view="clr-namespace:QLTB.UserControlFolder.DashBoard"
        xmlns:device="clr-namespace:QLTB.UserControlFolder.Device"
        xmlns:material="clr-namespace:QLTB.UserControlFolder.Material"
        xmlns:employee="clr-namespace:QLTB.UserControlFolder.Employee"
        xmlns:maintenance="clr-namespace:QLTB.UserControlFolder.Maintenance"
        xmlns:Incident="clr-namespace:QLTB.UserControlFolder.IncidentReport"
        xmlns:Setting="clr-namespace:QLTB.UserControlFolder.Setting"
        xmlns:Statistic="clr-namespace:QLTB.UserControlFolder.Statistic"
        xmlns:converter ="clr-namespace:QLTB.Helpers"
         Height="900"
         Width="1280"
         WindowState="Maximized"
         WindowStartupLocation="CenterScreen"
         ResizeMode="CanResize" 
        WindowStyle="None"
         FontFamily="Segoe UI"
         Background="#F8FAFC">
    <Window.Resources>
    <DataTemplate DataType="{x:Type vm:DashBoardViewModel}">
        <view:DashBoardView/>
    </DataTemplate>

      <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
            <device:DeviceView/>
      </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MaterialViewModel}">
        <material:MaterialView/>
        </DataTemplate>
        

        <DataTemplate DataType="{x:Type vm:EmployeeViewModel}">
            <employee:EmployeeView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MaintenancePlanViewModel}">
            <maintenance:MaintenancePlan/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MaintenanceTaskViewModel}">
            <maintenance:MaintenanceTask/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MaintenanceHistoryViewModel}">
            <maintenance:MaintenanceHistoryView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:IncidentReportViewModel}">
            <Incident:IncidentReportView/>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:SettingViewModel}">
            <Setting:SettingMainView/>
            </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StatisticViewModel}">
            <Statistic:StatisticView/>
        </DataTemplate>
        <!-- Active Sidebar Button -->
    <Style x:Key="SidebarButtonActive"
            TargetType="Button"
            BasedOn="{StaticResource SidebarButton}">
        <Setter Property="Background" Value="#EFF6FF"/>
        <Setter Property="Foreground" Value="#2563EB"/>
    </Style>

        <converter:ConvertAccount x:Key="RoleConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
             Background="White"
             BorderBrush="#E5E7EB"
             BorderThickness="0 0 1 0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0"
                         Orientation="Horizontal"
                         VerticalAlignment="Center"
                         Margin="26 0 0 0">

                    <Border Width="34"
                         Height="34"
                         Background="#2563EB"
                         CornerRadius="9">
                        <fa:ImageAwesome Icon="Archive"
                                      Width="16"
                                      Height="16"
                                      Foreground="White"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Quản lý bảo trì"
                            Margin="12 0 0 0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#111827"/>
                </StackPanel>

                <!-- Menu -->
                <StackPanel Grid.Row="1" Margin="0 12 0 0">

                    <Button Style="{StaticResource SidebarButton}" Command="{Binding OpenDashboardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="ThLarge" Width="16" Height="16" Margin="0 0 12 0"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenEmployeeCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UserAccount.LoaiTaiKhoan}" Value="2">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Users" Width="16" Height="16" Margin="0 0 12 0"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Nhân viên bảo trì"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenDeviceCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UserAccount.LoaiTaiKhoan}" Value="2">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Archive" Width="16" Height="16" Margin="0 0 12 0"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Thiết bị"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenMaintenancePlanCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UserAccount.LoaiTaiKhoan}" Value="2">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Calendar" Width="16" Height="16" Margin="0 0 12 0"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Kế hoạch bảo trì"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenMaintenanceTaskCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UserAccount.LoaiTaiKhoan}" Value="2">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="ListAlt" Width="16" Height="16" Margin="0 0 12 0"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Danh sách bảo trì cần làm" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenMaintenanceHistoryCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UserAccount.LoaiTaiKhoan}" Value="2">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="History" Width="16" Height="16" Margin="0 0 12 0"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Lịch sử bảo trì"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenIncidentReportCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UserAccount.LoaiTaiKhoan}" Value="2">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="ExclamationTriangle" Width="16" Height="16" Margin="0 0 12 0"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Báo cáo sự cố"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenStatisticCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UserAccount.LoaiTaiKhoan}" Value="1">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UserAccount.LoaiTaiKhoan}" Value="2">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="BarChart" Width="16" Height="16" Margin="0 0 12 0"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Thống kê"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SidebarButton}" Command="{Binding OpenSettingCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Cog" Width="16" Height="16" Margin="0 0 12 0"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Cài đặt"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Column="1" Background="#F8FAFC">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOPBAR -->
            <Border Grid.Row="0"
                 Background="White"
                 BorderBrush="#E5E7EB"
                 BorderThickness="0 0 0 1">

                <Grid Margin="24 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
<Border Height="72" 
        Background="White" 
        BorderBrush="#E5E7EB" 
        BorderThickness="0,0,0,1" 
        Padding="24,0">
    
    <Grid>
        <Border Width="470"
                Height="40"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="#F9FAFB" 
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"> <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <fa:ImageAwesome Icon="InfoCircle" 
                               Width="14" 
                               Height="14" 
                               Foreground="#6B7280" 
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                <TextBox Grid.Column="1"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         FontSize="16"
                         FontWeight="Medium"
                         Foreground="#374151" 
                         IsReadOnly="True"
                         Text="Chào mừng bạn đến với HTBB Company"/>
            </Grid>
        </Border>
        
        </Grid>
</Border>

                    <!-- Right user area -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- NOTIFICATION BUTTON -->
                        <Button Width="40"
                                Height="40"
                                Margin="0 0 14 0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">

                            <Grid Width="36" Height="36">

                                <Border Background="#F9FAFB"
                                        CornerRadius="18">
                                    <fa:ImageAwesome Icon="BellOutline"
                                                     Width="18"
                                                     Height="18"
                                                     Foreground="#6B7280"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                </Border>

                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="#EF4444"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Margin="0 7 6 0"/>

                            </Grid>
                        </Button>

                        <!-- USER BUTTON -->
                        <ToggleButton x:Name="UserMenuButton"
                                      Background="White"
                                      BorderThickness="0"
                                      Cursor="Hand"
                                      Padding="10,6">

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                <Border Width="36"
                                Height="36"
                                CornerRadius="18"
                                Margin="0,0,10,0"
                                Background="#2563EB">
                                                            <Grid>
                                                            <TextBlock Text="NV"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>     

                                        <Border CornerRadius="18">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding CurrentAvatar}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UserDetail.HoTen}"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"/>
                                    <TextBlock Text="{Binding UserAccount.LoaiTaiKhoan, Converter={StaticResource RoleConverter}}"
                                               FontSize="12"
                                               Foreground="#6B7280"/>
                                </StackPanel>

                                <fa:ImageAwesome Icon="AngleDown"
                                                 Width="12"
                                                 Height="12"
                                                 Foreground="#6B7280"
                                                 Margin="14,0,0,0"
                                                 VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- DROPDOWN MENU -->
                        <Popup IsOpen="{Binding IsChecked, ElementName=UserMenuButton}"
                               PlacementTarget="{Binding ElementName=UserMenuButton}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               PopupAnimation="Fade">

                            <Border Width="200"
                                    Background="White"
                                    CornerRadius="10"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    Padding="10"
                                    Margin="0,8,0,0">

                                <StackPanel>
                                    <Button Style="{StaticResource BorderButton}"
                                            Background="#F1F5F9"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding OpenSettingCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:ImageAwesome Icon="Cog"
                                         Width="14"
                                         Height="14"
                                         Foreground="#111827"
                                         Margin="0,0,12,0"/>
                                            <TextBlock Text="Cài đặt"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Border Height="1"
                                            Background="#E5E7EB"
                                            Margin="0,8"/>

                                    <Button Style="{StaticResource BorderButton}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding SignOutCommand}"
                                            CommandParameter="{Binding ElementName=thisWindow}"
                                            >
                                        <StackPanel Orientation="Horizontal">
                                            <fa:ImageAwesome Icon="SignOut"
                                         Width="14"
                                         Height="14"
                                         Foreground="#EF4444"
                                         Margin="0,0,12,0"/>
                                            <TextBlock Text="Đăng xuất"
                                                       VerticalAlignment="Center"
                                                        Foreground="#EF4444"/>
                                        </StackPanel>
                                    </Button>

                                </StackPanel>
                            </Border>
                        </Popup>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ContentControl Margin="24"
                  Content="{Binding CurrentViewModel, NotifyOnTargetUpdated=True}">

                    <ContentControl.RenderTransform>
                        <TranslateTransform />
                    </ContentControl.RenderTransform>

                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.3"/>

                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="30" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>

                </ContentControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
