<UserControl x:Class="QLTB.UserControlFolder.DashBoard.DashBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QLTB.UserControlFolder.DashBoard"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
         Background="#F8FAFC">

    <UserControl.Resources>
        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource BlueButton}">
            <Setter Property="Background" Value="#EF4444"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12 0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Dashboard"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#111827"/>
                    <TextBlock Text="Tổng quan hệ thống quản lý bảo trì thiết bị"
                           Margin="0 6 0 0"
                           FontSize="14"
                           Foreground="#6B7280"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                    <Button
                        
                        Style="{StaticResource BlueButton}" Margin="0 0 12 0"
                            Command="{Binding OpenBaoTriFormCommand}"
                        Visibility="{Binding CanShow, Converter={StaticResource BoolToVisibilityConverter}}"
                            >
                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Plus"
                     Width="14"
                     Height="14"
                     Foreground="White"
                     Margin="0 0 8 0"/>
                            <TextBlock Text="Tạo kế hoạch bảo trì"/>
                        </StackPanel>
                    </Button>

                    

                    

                    <Button Style="{StaticResource RedButton}"
                        Content="⚠  Báo cáo sự cố"
                            Command="{Binding OpenIncidentFormCommand}"
                            />
                </StackPanel>
            </Grid>

            <!-- Cards -->
            <UniformGrid Grid.Row="2"
                     Columns="4"
                     Rows="1">

                <Border Style="{StaticResource CardStyle}" Margin="0 0 18 0">
                    <Grid>
                        <Border Width="48"
                            Height="48"
                            Background="#DBEAFE"
                            CornerRadius="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                            <fa:ImageAwesome Icon="Archive"
                             Width="24"
                             Height="24"
                             Foreground="#2563EB"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Tổng thiết bị" Foreground="Black" />
                            <TextBlock Text="{Binding TotalDevice, UpdateSourceTrigger=PropertyChanged}"
                                   Margin="0 12 0 0"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0 0 18 0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Đến hạn bảo trì" Foreground="Black"/>
                            <TextBlock Text="{Binding DeviceNeedRepair, UpdateSourceTrigger=PropertyChanged}"
                                   Margin="0 12 0 0"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"/>
                        </StackPanel>
                        <Border Width="48"
                            Height="48"
                            Background="#DBEAFE"
                            CornerRadius="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                            <fa:ImageAwesome Icon="ClockOutline"
                             Width="24"
                             Height="24"
                             Foreground="#2563EB"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>

                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0 0 18 0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Quá hạn bảo trì" Foreground="Black"/>
                            <TextBlock Text="{Binding DeviceOverRepair, UpdateSourceTrigger=PropertyChanged}"
                                   Margin="0 12 0 0"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#EF4444"/>
                        </StackPanel>
                        <Border Width="48"
                            Height="48"
                            Background="#FEE2E2"
                            CornerRadius="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                            <fa:ImageAwesome Icon="Exclamation"
                             Width="24"
                             Height="24"
                             Foreground="#EF4444"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                

            </UniformGrid>

            <!-- Section title -->
            <TextBlock Grid.Row="4"
                   Text="Danh sách bảo trì"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#111827"/>

            <!-- Filter -->
            <Border Grid.Row="5"
    Style="{StaticResource CardStyle}"
    Margin="0 22 0 0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0 0 16 0">
                            <TextBlock Text="Từ ngày" FontWeight="SemiBold" Foreground="#374151" Margin="0 0 0 8"/>
                            <DatePicker 
                                SelectedDate="{Binding FromDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Height="42" Style="{StaticResource ModernDatePicker}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0 0 16 0">
                            <TextBlock Text="Đến ngày" FontWeight="SemiBold" Foreground="#374151" Margin="0 0 0 8"/>
                            <DatePicker
                                SelectedDate="{Binding ToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Height="42" Style="{StaticResource ModernDatePicker}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0 0 16 0">
                            <TextBlock Text="Phòng ban" FontWeight="SemiBold" Foreground="#374151" Margin="0 0 0 8"/>
                            <ComboBox 
                                Style="{StaticResource ModernComboBox}"
                            Height="42" 
                            ItemsSource="{Binding ListPhongBan}"
                            DisplayMemberPath="TenPhong"
                            SelectedValuePath="IdPhong"
                            SelectedValue="{Binding SelectedID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      >
                                
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="0 0 16 0">
                            <TextBlock Text="Nhân viên" FontWeight="SemiBold" Foreground="#374151" Margin="0 0 0 8"/>
                            <ComboBox   Style="{StaticResource ModernComboBox}"
                                    Height="42" 
                                    ItemsSource="{Binding ListNhanVien}"
                                    DisplayMemberPath="HoTen"
                                    SelectedValuePath="IdnhanVien"
                                    SelectedValue="{Binding SelectedNVId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        >
                                
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Trạng thái" FontWeight="SemiBold" Foreground="#374151" Margin="0 0 0 8"/>
                            <ComboBox   Style="{StaticResource ModernComboBox}"
                                    Height="42" 
                                        SelectedValuePath="Content"
                                        SelectedValue="{Binding SelectedState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="Tất cả"/>
                                <ComboBoxItem Content="Hoàn thành"/>
                                <ComboBoxItem Content="Quá hạn"/>
                                <ComboBoxItem Content="Đang xử lý"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0 18 0 0">
                        <Button Style="{StaticResource BlueButton}"
                Height="42"
                Padding="22 0"
                Margin="0 0 12 0"
                Command="{Binding FilterCommand}"                
                                >
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" Margin="0 0 8 0"/>
                                <TextBlock Text="Tìm kiếm" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource BeautyButton}"
                Height="42"
                Padding="22 0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Command="{Binding ResetCommand}"                
                                >
                            
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↻" Margin="0 0 8 0" Foreground="#6B7280"/>
                                <TextBlock Text="Reset" Foreground="#6B7280" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Table -->
            <Border Grid.Row="6"
                Style="{StaticResource CardStyle}"
                Padding="0"
                CornerRadius="12"
                Margin="0 24 0 0"
                ClipToBounds="True"
                Height="350">

                <DataGrid Style="{StaticResource ModernDataGrid}"
                          ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                          RowStyle="{StaticResource ModernDataGridRow}"
                          ItemsSource="{Binding ListBaoTri}"
                          AlternationCount="2"
                          HorizontalScrollBarVisibility="Auto"
                          >
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Tên thiết bị" Width="2*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeviceName}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Serial / Asset code" Width="1.5*" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AssetCode}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Loại công việc" Width="2.5*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding JobType}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Ngày bắt đầu" Width="1.2*" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StartDate, StringFormat={}{0:dd/MM/yyyy}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Ngày đến hạn" Width="1.2*" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EndDate, StringFormat={}{0:dd/MM/yyyy}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Nhân viên đảm nhận" Width="1.5*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EmployeeName}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Tình trạng" Width="1.2*" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusTagStyle}">
                                        <TextBlock
                                            
                                            Text="{Binding Status}"
                                            FontSize="12"
                           FontWeight="SemiBold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
