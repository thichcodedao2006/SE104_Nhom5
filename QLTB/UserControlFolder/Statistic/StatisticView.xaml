<UserControl x:Class="QLTB.UserControlFolder.Statistic.StatisticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="#F8FAFC">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">

            <!-- HEADER -->
            <Grid Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock Text="THỐNG KÊ"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#111827"/>
                    <TextBlock Text="Tổng quan số liệu thiết bị và hoạt động bảo trì"
                               FontSize="15"
                               Foreground="#6B7280"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <Button Content="Xuất báo cáo"
                        Width="150"
                        Height="46"
                        HorizontalAlignment="Right"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Style="{StaticResource BlueButton}"/>
            </Grid>

            <!-- SUMMARY CARDS -->
            <UniformGrid Columns="4" Margin="0,0,0,28">

                <Border Style="{StaticResource CardStyle}" Margin="0,0,14,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Tổng thiết bị" Foreground="#6B7280" FontSize="14"/>
                            <TextBlock Text="24" FontSize="32" FontWeight="Bold" Margin="0,12,0,0"/>
                        </StackPanel>
                        <fa:ImageAwesome Icon="Desktop" Width="32" Height="32"
                                         Foreground="#2563EB"
                                         HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="14,0,14,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Đang hoạt động" Foreground="#6B7280" FontSize="14"/>
                            <TextBlock Text="18" FontSize="32" FontWeight="Bold" Foreground="#10B981" Margin="0,12,0,0"/>
                        </StackPanel>
                        <fa:ImageAwesome Icon="CheckCircle" Width="32" Height="32"
                                         Foreground="#10B981"
                                         HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="14,0,14,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Bảo trì trong tháng" Foreground="#6B7280" FontSize="14"/>
                            <TextBlock Text="7" FontSize="32" FontWeight="Bold" Foreground="#F59E0B" Margin="0,12,0,0"/>
                        </StackPanel>
                        <fa:ImageAwesome Icon="Calendar" Width="32" Height="32"
                                         Foreground="#F59E0B"
                                         HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="14,0,0,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Sự cố chưa xử lý" Foreground="#6B7280" FontSize="14"/>
                            <TextBlock Text="3" FontSize="32" FontWeight="Bold" Foreground="#EF4444" Margin="0,12,0,0"/>
                        </StackPanel>
                        <fa:ImageAwesome Icon="ExclamationTriangle" Width="32" Height="32"
                                         Foreground="#EF4444"
                                         HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

            </UniformGrid>

            <!-- CHART AREA -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- BAR CHART PLACEHOLDER -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="14"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="24"
                        Height="400">

                    <StackPanel>
                        <TextBlock Text="Công việc bảo trì theo tháng"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,24"/>

                        <lvc:CartesianChart Series="{Binding MaintenanceSeries}"
                                    XAxes="{Binding MaintenanceXAxes}"
                                    YAxes="{Binding MaintenanceYAxes}"
                                    Height="280"
                                            Margin="0 0 0 20"/>
                    </StackPanel>
                </Border>

                <!-- PIE CHART PLACEHOLDER -->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="14"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        Padding="24"
                        Height="360">

                    <StackPanel>
                        <TextBlock Text="Trạng thái thiết bị"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,24"/>
                        <lvc:PieChart Series="{Binding DeviceStatusSeries}"
                                     Height="260"/>

                        <Grid Height="210">
                            <TextBlock Text="Biểu đồ tròn"
                                       Foreground="#9CA3AF"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="● Hoạt động: 18" Foreground="#10B981" FontSize="14"/>
                            <TextBlock Text="● Bảo trì: 4" Foreground="#F59E0B" FontSize="14" Margin="0,8,0,0"/>
                            <TextBlock Text="● Hỏng: 2" Foreground="#EF4444" FontSize="14" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- COST CHART -->
            <Border Background="White"
                    CornerRadius="14"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="24"
                    Height="400"
                    Margin="0,0,0,28">

                <StackPanel>
                    <TextBlock Text="Chi phí bảo trì theo tháng"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,24"/>

                    <lvc:CartesianChart Series="{Binding CostSeries}"
                                        XAxes="{Binding CostXAxes}"
                                        YAxes="{Binding CostYAxes}"
                                        Height="230"
                                        Margin="0,0,0,12"/>
                </StackPanel>
            </Border>

            <!-- TABLE -->
            <Border Background="White"
                    CornerRadius="14"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="24">

                <StackPanel>
                    <TextBlock Text="Thiết bị phát sinh sự cố nhiều nhất"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,18"/>

                    <DataGrid AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              RowHeight="48"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              Style="{StaticResource ModernDataGrid}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                              RowStyle="{StaticResource ModernDataGridRow}"
                              CellStyle="{StaticResource ModernDataGridCell}">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Thiết bị" Width="*" Binding="{Binding TenThietBi}"  ElementStyle="{StaticResource CenterTextStyle}"/>
                            <DataGridTextColumn Header="Số seri" Width="*" Binding="{Binding SoSeri}"  ElementStyle="{StaticResource CenterTextStyle}"/>
                            <DataGridTextColumn Header="Loại thiết bị" Width="*" Binding="{Binding LoaiThietBi}"  ElementStyle="{StaticResource CenterTextStyle}"/>
                            <DataGridTextColumn Header="Số sự cố" Width="*" Binding="{Binding SoSuCo}"  ElementStyle="{StaticResource CenterTextStyle}"/>
                            <DataGridTextColumn Header="Lần gần nhất" Width="*" Binding="{Binding LanGanNhat}"  ElementStyle="{StaticResource CenterTextStyle}"/>
                            <DataGridTextColumn Header="Trạng thái" Width="*" Binding="{Binding TrangThai}"  ElementStyle="{StaticResource CenterTextStyle}"/>
                        </DataGrid.Columns>

                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>