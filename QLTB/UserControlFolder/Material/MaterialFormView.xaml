<UserControl x:Class="QLTB.UserControlFolder.Material.MaterialFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QLTB.UserControlFolder.Material"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             Background="Transparent">

    <Border Width="760"
        Background="White"
        CornerRadius="18"
        Padding="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="76"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0"
                BorderBrush="#E5E7EB"
                BorderThickness="0 0 0 1"
                Padding="26 0">

                <Grid>
                    <TextBlock Text="Thêm vật tư mới"
                           VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                    <Button Width="36"
                        Height="36"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding CloseFormCommand}">
                        <fa:ImageAwesome Icon="Close"
                                     Width="14"
                                     Height="14"
                                     Foreground="#6B7280"/>
                    </Button>
                </Grid>
            </Border>

            <!-- BODY -->
            <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

                <Grid Margin="26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Tên + Mã -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Tên vật tư"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0 0 0 8"/>

                            <TextBox Style="{StaticResource RoundedTextBox}"
                                 Height="42"
                                 Padding="12 0"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding MaterialName}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Mã vật tư"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0 0 0 8"/>

                            <TextBox Style="{StaticResource RoundedTextBox}"
                                 Height="42"
                                 Padding="12 0"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding MaterialCode}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Đơn vị + Tồn + Giá -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Đơn vị"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0 0 0 8"/>

                            <ComboBox Style="{StaticResource ModernComboBox}"
                            Height="42"
                                  SelectedIndex="0">
                                <ComboBoxItem Content="Cái"/>
                                <ComboBoxItem Content="Bộ"/>
                                <ComboBoxItem Content="Mét"/>
                                <ComboBoxItem Content="Lít"/>
                                <ComboBoxItem Content="Kg"/>
                                <ComboBoxItem Content="Ống"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tồn hiện tại"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0 0 0 8"/>

                            <TextBox Style="{StaticResource RoundedTextBox}"
                                 Height="42"
                                 Padding="12 0"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding CurrentStock}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Đơn giá"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0 0 0 8"/>

                            <TextBox Style="{StaticResource RoundedTextBox}"
                                 Height="42"
                                 Padding="12 0"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding Price}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Min Max -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Tồn tối thiểu"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0 0 0 8"/>

                            <TextBox Style="{StaticResource RoundedTextBox}"
                                 Height="42"
                                 Padding="12 0"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding MinStock}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tồn tối đa"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="0 0 0 8"/>

                            <TextBox Style="{StaticResource RoundedTextBox}"
                                 Height="42"
                                 Padding="12 0"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding MaxStock}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Nhà cung cấp -->
                    <StackPanel Grid.Row="6">
                        <TextBlock Text="Nhà cung cấp"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               Margin="0 0 0 8"/>

                        <TextBox Style="{StaticResource RoundedTextBox}"
                             Height="42"
                             Padding="12 0"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Text="{Binding Supplier}"/>
                    </StackPanel>

                    <!-- Mô tả -->
                    <StackPanel Grid.Row="8">
                        <TextBlock Text="Mô tả"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               Margin="0 0 0 8"/>

                        <TextBox Style="{StaticResource RoundedTextBox}"
                             Height="96"
                             Padding="12"
                             FontSize="14"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Description}"/>
                    </StackPanel>

                    <!-- Upload ảnh -->
                    <StackPanel Grid.Row="10">
                        <TextBlock Text="Hình ảnh vật tư"
                               FontWeight="SemiBold"
                               Foreground="#111827"
                               Margin="0 0 0 8"/>

                        <Border Height="120"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="14"
                            Background="#F9FAFB">

                            <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <fa:ImageAwesome Icon="Upload"
                                             Width="28"
                                             Height="28"
                                             Foreground="#6B7280"
                                             HorizontalAlignment="Center"/>

                                <TextBlock Text="Kéo thả hoặc bấm để tải ảnh lên"
                                       Margin="0 10 0 0"
                                       Foreground="#6B7280"
                                       FontSize="14"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- FOOTER -->
            <Border Grid.Row="2"
                Background="#F9FAFB"
                BorderBrush="#E5E7EB"
                BorderThickness="0 1 0 0"
                CornerRadius="0 0 18 18"
                Padding="26 0">

                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                    <Button Content="Hủy"
                        Height="42"
                        Padding="22 0"
                        Margin="0 0 12 0"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        Command="{Binding CloseFormCommand}"/>

                    <Button Content="Lưu vật tư"
                        Height="42"
                        Padding="24 0"
                        Background="#8B5CF6"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Command="{Binding SaveMaterialCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
