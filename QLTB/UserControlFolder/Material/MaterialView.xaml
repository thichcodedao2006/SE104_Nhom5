<UserControl x:Class="QLTB.UserControlFolder.Material.MaterialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QLTB.UserControlFolder.Material"
             xmlns:helpers="clr-namespace:QLTB.Helpers"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             Background="#F8FAFC">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Quản lý vật tư"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#111827"/>

                <TextBlock Text="Quản lý linh kiện, phụ tùng và tồn kho"
                       Margin="0 6 0 0"
                       FontSize="14"
                       Foreground="#6B7280"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">

                <Button Style="{StaticResource BlueButton}"
                    Height="42"
                    Padding="18 0"
                    Margin="0 0 12 0"
                    Background="#6699FF"
                    BorderBrush="#6699FF"
                    BorderThickness="1"
                    Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Upload"
                                     Width="14"
                                     Height="14"
                                     Margin="0 0 8 0"/>
                        <TextBlock Text="Nhập file"
                               Foreground="Black"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource BlueButton}"
                    Height="42"
                    Padding="18 0"
                    Margin="0 0 12 0"
                    Background="#6699FF"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Download"
                                     Width="14"
                                     Height="14"
                                     Margin="0 0 8 0"/>
                        <TextBlock Text="Xuất file"
                               Foreground="Black"/>
                    </StackPanel>
                </Button>

                <Button 
                    Command="{Binding OpenAddMaterialFormCommand}"
                    Style="{StaticResource BlueButton}"
                    Height="42"
                    Padding="20 0"
                    Background="#8B5CF6"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Plus"
                                     Width="14"
                                     Height="14"
                                     Foreground="White"
                                     Margin="0 0 8 0"/>
                        <TextBlock Text="Thêm vật tư"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- MAIN CARD -->
        <Border Grid.Row="2"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="18"
            Padding="24">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- SEARCH -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Height="44"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="12">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <fa:ImageAwesome Icon="Search"
                                         Width="15"
                                         Height="15"
                                         Foreground="#6B7280"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 Foreground="#111827"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Column="1"
                                   Text="Tìm kiếm theo tên, mã hoặc nhà cung cấp..."
                                   Foreground="#9CA3AF"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">

                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding SearchText}"
                                                     Value="">
                                                <Setter Property="Visibility"
                                                    Value="Visible"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding SearchText}"
                                                     Value="{x:Null}">
                                                <Setter Property="Visibility"
                                                    Value="Visible"/>
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>

                            </TextBlock>
                        </Grid>
                    </Border>

                    <Button Grid.Column="2"
                        Height="44"
                        Padding="18 0"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Cursor="Hand">

                        <StackPanel Orientation="Horizontal">
                            <fa:ImageAwesome Icon="Filter"
                                         Width="14"
                                         Height="14"
                                         Margin="0 0 8 0"/>
                            <TextBlock Text="Bộ lọc"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- FILTER -->
                <Border Grid.Row="2"
                    Background="#F9FAFB"
                    CornerRadius="14"
                    Padding="18">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Trạng thái -->
                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Trạng thái"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="0 0 0 8"/>

                            <ComboBox Height="40"
                                  SelectedIndex="0" Style="{StaticResource ModernComboBox}">

                                <ComboBoxItem Content="Tất cả"/>
                                <ComboBoxItem Content="Còn hàng"/>
                                <ComboBoxItem Content="Sắp hết"/>
                                <ComboBoxItem Content="Hết hàng"/>

                            </ComboBox>

                        </StackPanel>

                        <!-- Nhà cung cấp -->
                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Nhà cung cấp"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="0 0 0 8"/>

                            <ComboBox Height="40"
                                  SelectedIndex="0" Style="{StaticResource ModernComboBox}">

                                <ComboBoxItem Content="Tất cả"/>
                                <ComboBoxItem Content="Kingston"/>
                                <ComboBoxItem Content="Samsung"/>
                                <ComboBoxItem Content="Intel"/>
                                <ComboBoxItem Content="Corsair"/>

                            </ComboBox>

                        </StackPanel>

                        <!-- Mức tồn -->
                        <StackPanel Grid.Column="4">

                            <TextBlock Text="Mức tồn kho"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   Margin="0 0 0 8"/>

                            <ComboBox Height="40"
                                  SelectedIndex="0" Style="{StaticResource ModernComboBox}">

                                <ComboBoxItem Content="Bất kỳ"/>
                                <ComboBoxItem Content="Dưới tối thiểu"/>
                                <ComboBoxItem Content="Trong định mức"/>
                                <ComboBoxItem Content="Vượt tối đa"/>

                            </ComboBox>

                        </StackPanel>

                        <!-- Reset -->
                        <Button Grid.Column="6"
                            Style="{StaticResource BeautyButton}"
                            Height="40"
                            Margin="0 20 0 0"
                            Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            Content="Đặt lại bộ lọc"
                            Foreground="Black"
                            />
                    </Grid>
                </Border>

                <!-- TABLE -->
                <DataGrid Grid.Row="4"
                      Style="{StaticResource ModernDataGrid}"
                      ItemsSource="{Binding Materials}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      RowHeight="64"
                      Background="White"
                      AlternatingRowBackground="#FFF7ED" >

                    <DataGrid.Columns>

                        <!-- TÊN -->
                        <DataGridTemplateColumn Header="TÊN VẬT TƯ"
                                            Width="2*">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal">

                                        <Border Width="34"
                                            Height="34"
                                            Background="#F3F4F6"
                                            CornerRadius="17"
                                            Margin="0 0 12 0">

                                            <fa:ImageAwesome Icon="Cube"
                                                         Width="14"
                                                         Height="14"
                                                         Foreground="#6B7280"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>

                                        </Border>

                                        <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"/>

                                    </StackPanel>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- MÃ -->
                        <DataGridTextColumn Header="MÃ"
                                        Binding="{Binding Code}"
                                        Width="1.3*"/>

                        <!-- ĐƠN VỊ -->
                        <DataGridTextColumn Header="ĐƠN VỊ"
                                        Binding="{Binding Unit}"
                                        Width="0.8*"/>

                        <!-- TỒN -->
                        <DataGridTextColumn Header="TỒN"
                                        Binding="{Binding CurrentStock}"
                                        Width="0.7*"/>

                        <!-- MIN/MAX -->
                        <DataGridTextColumn Header="MIN/MAX"
                                        Binding="{Binding MinMaxText}"
                                        Width="1*"/>

                        <!-- GIÁ -->
                        <DataGridTextColumn Header="GIÁ"
                                        Binding="{Binding Price, StringFormat={}{0:N0} đ}"
                                        Width="1*"/>

                        <!-- NHÀ CUNG CẤP -->
                        <DataGridTextColumn Header="NHÀ CUNG CẤP"
                                        Binding="{Binding Supplier}"
                                        Width="1.6*"/>

                        <!-- TRẠNG THÁI -->
                        <DataGridTemplateColumn Header="TRẠNG THÁI"
                                            Width="1.2*">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <Border CornerRadius="12"
                                        Padding="10 4"
                                        Background="#DCFCE7"
                                        HorizontalAlignment="Left">

                                        <TextBlock Text="{Binding StockStatus}"
                                               Foreground="#047857"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>

                                    </Border>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- NGÀY -->
                        <DataGridTextColumn Header="CẬP NHẬT"
                                        Binding="{Binding UpdatedDate}"
                                        Width="1.1*"/>

                        <!-- ACTION -->
                        <DataGridTemplateColumn Header="THAO TÁC"
                                            Width="1*">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal">

                                        <Button Width="32"
                                            Height="32"
                                            Background="Transparent"
                                            BorderThickness="0">

                                            <fa:ImageAwesome Icon="Edit"
                                                         Width="14"
                                                         Height="14"
                                                         Foreground="#6B7280"/>

                                        </Button>

                                        <Button Width="32"
                                            Height="32"
                                            Background="Transparent"
                                            BorderThickness="0">

                                            <fa:ImageAwesome Icon="Trash"
                                                         Width="14"
                                                         Height="14"
                                                         Foreground="#6B7280"/>

                                        </Button>

                                    </StackPanel>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- FOOTER -->
                <Grid Grid.Row="6">

                    <TextBlock VerticalAlignment="Center"
                           Foreground="#6B7280"
                           FontSize="14">

                    <Run Text="Hiển thị "/>
                    <Run Text="{Binding Materials.Count}"
                         FontWeight="Bold"/>
                    <Run Text=" vật tư"/>

                    </TextBlock>

                    <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                        <Button Content="Trước"
                            Height="34"
                            Padding="14 0"
                            Margin="0 0 8 0"
                            Background="White"
                            BorderBrush="#E5E7EB"/>

                        <Button Content="1"
                            Width="34"
                            Height="34"
                            Margin="0 0 8 0"
                            Background="White"
                            BorderBrush="#E5E7EB"/>

                        <Button Content="2"
                            Width="34"
                            Height="34"
                            Margin="0 0 8 0"
                            Background="#8B5CF6"
                            Foreground="White"
                            BorderThickness="0"/>

                        <Button Content="3"
                            Width="34"
                            Height="34"
                            Margin="0 0 8 0"
                            Background="White"
                            BorderBrush="#E5E7EB"/>

                        <Button Content="Tiếp"
                            Height="34"
                            Padding="14 0"
                            Background="White"
                            BorderBrush="#E5E7EB"/>

                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <!-- FORM OVERLAY -->
        <Grid Background="#80000000"
               Visibility="{Binding IsFormOpen,
               Converter={StaticResource BoolToVisibilityConverter}}">

            <local:MaterialFormView
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Grid>

    </Grid>
</UserControl>
