<UserControl x:Class="QLTB.UserControlFolder.Setting.SettingSecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:con="clr-namespace:QLTB.Condition"
             Background="White">

    <Grid>

        <StackPanel Width="auto"
                    HorizontalAlignment="Center"
                    Height="600">

            <!-- TITLE -->
            <TextBlock Text="Đổi mật khẩu"
                       FontSize="30"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#111827"
                       Margin="0,0,0,40"/>

            <!-- MẬT KHẨU HIỆN TẠI -->
            <StackPanel Margin="0,30,0,24">

                <TextBlock Text="Mật khẩu hiện tại"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           
                           Margin="0,0,0,8"/>

                <Border Height="54"
                        Width="auto"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1.5"
                        CornerRadius="18">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ICON -->
                        <Border Width="32"
                                Height="32"
                                Background="#EFF6FF"
                                CornerRadius="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <fa:ImageAwesome Icon="Lock"
                                             Width="15"
                                             Height="15"
                                             Foreground="#2563EB"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>

                        </Border>

                        <!-- INPUT -->
                        <PasswordBox 
                            x:Name="txtCurrentMatKhau"
                            Grid.Column="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="15"
                                     VerticalContentAlignment="Center"
                                     Padding="0,0,16,0">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PasswordChanged">
                                    <i:InvokeCommandAction 
            Command="{Binding CurrentPasswordChangedCommand}"
            CommandParameter="{Binding ElementName=txtCurrentMatKhau}"
            ></i:InvokeCommandAction>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <i:Interaction.Behaviors>
                                <con:PasswordInputCondition></con:PasswordInputCondition>
                            </i:Interaction.Behaviors>

                        </PasswordBox>

                    </Grid>

                </Border>

            </StackPanel>

            <!-- MẬT KHẨU MỚI -->
            <StackPanel Margin="0,0,0,24">

                <TextBlock Text="Mật khẩu mới"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                <Border Height="54"
                        Width="500"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1.5"
                        CornerRadius="18">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ICON -->
                        <Border Width="auto"
                                Height="32"
                                Background="#EFF6FF"
                                CornerRadius="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <fa:ImageAwesome Icon="Lock"
                                             Width="15"
                                             Height="15"
                                             Foreground="#2563EB"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>

                        </Border>

                        <!-- INPUT -->
                        <PasswordBox 
                            x:Name="txtNewMatKhau"
                            Grid.Column="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="15"
                                     VerticalContentAlignment="Center"
                                     Padding="0,0,16,0">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PasswordChanged">
                                    <i:InvokeCommandAction 
Command="{Binding NewPasswordChangedCommand}"
CommandParameter="{Binding ElementName=txtNewMatKhau}"
></i:InvokeCommandAction>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <i:Interaction.Behaviors>
                                <con:PasswordInputCondition></con:PasswordInputCondition>
                            </i:Interaction.Behaviors>

                        </PasswordBox>

                    </Grid>

                </Border>

            </StackPanel>

            <!-- XÁC NHẬN MẬT KHẨU -->
            <StackPanel Margin="0,0,0,36">

                <TextBlock Text="Xác nhận mật khẩu mới"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="0,0,0,8"/>

                <Border Height="54"
                        Width="auto"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1.5"
                        CornerRadius="18">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ICON -->
                        <Border Width="32"
                                Height="32"
                                Background="#EFF6FF"
                                CornerRadius="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                            <fa:ImageAwesome Icon="Lock"
                                             Width="15"
                                             Height="15"
                                             Foreground="#2563EB"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>

                        </Border>

                        <!-- INPUT -->
                        <PasswordBox 
                            x:Name="txtReNewMatKhau"
                            Grid.Column="1"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="15"
                                     VerticalContentAlignment="Center"
                                     Padding="0,0,16,0">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PasswordChanged">
                                    <i:InvokeCommandAction 
Command="{Binding ReNewPasswordChangedCommand}"
CommandParameter="{Binding ElementName=txtReNewMatKhau}"
></i:InvokeCommandAction>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <i:Interaction.Behaviors>
                                <con:PasswordInputCondition></con:PasswordInputCondition>
                            </i:Interaction.Behaviors>

                        </PasswordBox>

                    </Grid>

                </Border>

            </StackPanel>

            <!-- BUTTON -->
            <Button Content="Cập nhật mật khẩu"
                    Margin="0, 50, 0 0"
                    Style="{StaticResource BlueButton}"
                    Width="220"
                    Height="52"
                    Padding="28,0"
                    FontSize="15"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding UpdatePassCommand}"/>

        </StackPanel>

    </Grid>

</UserControl>