<UserControl x:Class="QLTB.UserControlFolder.Setting.SettingNotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White" Width="763">

    <StackPanel>

        <TextBlock Text="Tùy chọn thông báo"
                   FontSize="25"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="#111827"
                   Margin="0,0,0,36"/>

        <!-- Email -->
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Thông báo qua Email"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>
                <TextBlock Text="Nhận thông báo thông qua email"
                           FontSize="20"
                           Foreground="#64748B"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                          Grid.Column="1"
                          Width="53"
                          Height="30"
                          IsChecked="True"/>
        </Grid>

        <Border Height="1" Background="#E5E7EB" Margin="0,0,0,26"/>

        <!-- Push -->
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Thông báo đẩy"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>
                <TextBlock Text="Nhận thông báo trực tiếp trên hệ thống"
                           FontSize="20"
                           Foreground="#64748B"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                          Grid.Column="1"
                          Width="53"
                          Height="30"
                          IsChecked="True"/>
        </Grid>

        <Border Height="1" Background="#E5E7EB" Margin="0,0,0,26"/>

        <!-- Maintenance -->
        <Grid Margin="0,0,0,34">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Nhắc nhở bảo trì"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>
                <TextBlock Text="Nhận nhắc nhở cho các lịch bảo trì sắp tới"
                           FontSize="20"
                           Foreground="#64748B"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                          Grid.Column="1"
                          Width="53"
                          Height="30"
                          IsChecked="True"/>
        </Grid>

        <Button Content="Lưu tùy chọn"
                Style="{StaticResource BlueButton}"
                Width="170"
                Height="50"
                FontSize="20"
                FontWeight="Bold"
                HorizontalAlignment="Right"
                Background="#2563EB"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"/>

    </StackPanel>
</UserControl>