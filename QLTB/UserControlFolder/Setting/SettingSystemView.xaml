<UserControl x:Class="QLTB.UserControlFolder.Setting.SettingSystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             x:Name="thisUC"
             Background="White">

    <StackPanel>

        <!-- DATA MANAGEMENT -->
        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24"
                Height="280" Width="739"
                Margin="0,0,0,24">

            <StackPanel>
                <TextBlock Text="Quản lý dữ liệu"
                           HorizontalAlignment="Center"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#111827"
                           Margin="0,0,0,20"/>

                <!-- Backup -->
                <Button Style="{StaticResource BorderButton}"
                        Width="Auto"
                        Height="Auto"
                        Background="#F1F5F9"
                        BorderBrush="#D9E2EC"
                        BorderThickness="1"
                        Cursor="Hand"
                        Padding="16"
                        HorizontalContentAlignment="Stretch"
                        Margin="0,0,0,12">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <fa:ImageAwesome Icon="Database"
                                         Width="18"
                                         Height="18"
                                         Foreground="#111827"
                                         VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Sao lưu dữ liệu"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#111827"/>
                            <TextBlock Text="Tạo bản sao lưu cho toàn bộ dữ liệu hệ thống"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#64748B"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Export -->
                <Button Style="{StaticResource BorderButton}"
                        Width="Auto"
                        Height="Auto"
                        Background="#F1F5F9"
                        BorderBrush="#D9E2EC"
                        BorderThickness="1"
                        Cursor="Hand"
                        Padding="16"
                        HorizontalContentAlignment="Stretch">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <fa:ImageAwesome Icon="Database"
                                         Width="18"
                                         Height="18"
                                         Foreground="#111827"
                                         VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Xuất dữ liệu"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#111827"/>
                            <TextBlock Text="Xuất toàn bộ dữ liệu ra định dạng Excel hoặc CSV"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#64748B"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

        <!-- ACCOUNT ACTIONS -->
        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24" Height="210" Width="739">

            <StackPanel>
                <TextBlock Text="Thao tác tài khoản"
                           HorizontalAlignment="Center"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#111827"
                           Margin="0,0,0,20"/>

                <Button Style="{StaticResource BorderButton}"
                        Width="Auto"
                        Height="90"
                        Background="#FEE2E2"
                        BorderBrush="#FCA5A5"
                        BorderThickness="1"
                        Cursor="Hand"
                        Padding="16"
                        HorizontalContentAlignment="Stretch"
                        Command="{Binding LogOutCommand}"
                        CommandParameter="{Binding ElementName=thisUC}">

                    <Grid HorizontalAlignment="Left"
                           Margin="16,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <fa:ImageAwesome Icon="SignOut"
                                         Width="18"
                                         Height="18"
                                         Foreground="#EF4444"
                                         VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Đăng xuất"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#EF4444"/>
                            <TextBlock Text="Đăng xuất khỏi tài khoản hiện tại"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#EF4444"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>