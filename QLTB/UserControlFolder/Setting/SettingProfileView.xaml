<UserControl x:Class="QLTB.UserControlFolder.Setting.SettingProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QLTB.UserControlFolder.Setting"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" 
             Background="White"
             
             d:DesignHeight="500" d:DesignWidth="800">
    
    <StackPanel Margin="0">
        <TextBlock Text="Thông tin hồ sơ" 
                   FontSize="18" 
                   FontWeight="Bold" 
                   Foreground="#111827" 
                   Margin="0,0,0,25"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
            <Border Width="100" Height="100" 
                    Background="#EFF6FF" 
                    CornerRadius="50">
                <fa:ImageAwesome Icon="User" 
                               Width="40" Height="40" 
                               Foreground="#2563EB" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
            </Border>

            <StackPanel VerticalAlignment="Center" Margin="25,0,0,0">
                <Button Content="Tải ảnh lên" 
                        Style="{StaticResource BlueButton}" 
                        Height="40" Padding="20,0"
                        Background="#2563EB" Foreground="White"
                        BorderThickness="0" FontWeight="SemiBold"
                        Cursor="Hand"
                        Command="{Binding UploadPhotoCommand}"/>
                <TextBlock Text="Định dạng hỗ trợ: JPG, PNG. Dung lượng tối đa: 5MB" 
                           Foreground="#6B7280" 
                           FontSize="13" 
                           Margin="0,10,0,0"/>
            </StackPanel>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="Họ và tên" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                <TextBox Style="{StaticResource RoundedTextBox}" 
                         Height="42" Padding="12,0" VerticalContentAlignment="Center"
                         Tag="Nhập họ và tên"
                         Text="{Binding FullName}"/>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                <TextBox Style="{StaticResource RoundedTextBox}" 
                         Height="42" Padding="12,0" VerticalContentAlignment="Center"
                         Tag="Nhập địa chỉ email"
                         Text="{Binding Email}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0">
                <TextBlock Text="Số điện thoại" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                <TextBox Style="{StaticResource RoundedTextBox}" 
                         Height="42" Padding="12,0" VerticalContentAlignment="Center"
                         Tag="Nhập số điện thoại"
                         Text="{Binding Phone}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="2">
                <TextBlock Text="Vai trò" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                <TextBox Style="{StaticResource RoundedTextBox}" 
                         Height="42" Padding="12,0" VerticalContentAlignment="Center"
                         Background="#F9FAFB" Foreground="#6B7280" IsReadOnly="True"
                         Text="{Binding Role}"/>
            </StackPanel>
        </Grid>

        <Button Content="Lưu thay đổi" 
                Style="{StaticResource BlueButton}" 
                Height="42" Padding="25,0"
                HorizontalAlignment="Right"
                Margin="0,30,0,0"
                Background="#2563EB" Foreground="White"
                FontWeight="Bold" BorderThickness="0"
                Cursor="Hand"
                Command="{Binding SaveChangesCommand}">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>
    </StackPanel>
</UserControl>