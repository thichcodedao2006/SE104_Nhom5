<UserControl x:Class="QLTB.UserControlFolder.Maintenance.MaintenanceTask"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QLTB.UserControlFolder.Maintenance"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             Background="#F8FAFC">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="CÔNG VIỆC BẢO TRÌ" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="Theo dõi và quản lý các hoạt động bảo trì đã lên lịch" Margin="0 6 0 0" FontSize="14" Foreground="#6B7280"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="16" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Tổng công việc" FontSize="13" Foreground="#6B7280" Margin="0 0 0 10"/>
                        <TextBlock Text="{Binding TotalCount}" FontSize="34" FontWeight="Bold" Foreground="#111827"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="54" Height="54" Background="#DBEAFE" CornerRadius="12">
                        <fa:ImageAwesome Icon="Tasks" Width="24" Height="24" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="16" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Đang chờ" FontSize="13" Foreground="#6B7280" Margin="0 0 0 10"/>
                        <TextBlock Text="{Binding ProcessingCount}" FontSize="34" FontWeight="Bold" Foreground="#F59E0B"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="54" Height="54" Background="#FEF3C7" CornerRadius="12">
                        <fa:ImageAwesome Icon="ClockOutline" Width="24" Height="24" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="16" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Quá hạn" FontSize="13" Foreground="#6B7280" Margin="0 0 0 10"/>
                        <TextBlock Text="{Binding OverdueCount}" FontSize="34" FontWeight="Bold" Foreground="#EF4444"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="54" Height="54" Background="#FEE2E2" CornerRadius="12">
                        <fa:ImageAwesome Icon="ExclamationTriangle" Width="24" Height="24" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="6" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="16" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Hoàn thành" FontSize="13" Foreground="#6B7280" Margin="0 0 0 10"/>
                        <TextBlock Text="{Binding CompletedCount}" FontSize="34" FontWeight="Bold" Foreground="#10B981"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="54" Height="54" Background="#DCFCE7" CornerRadius="12">
                        <fa:ImageAwesome Icon="CheckCircle" Width="24" Height="24" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" Width="150" Height="40" SelectedValuePath="Content" SelectedValue="{Binding SelectedStatusFilter}" Style="{StaticResource ModernComboBox}">
                    <ComboBoxItem Content="Tất cả trạng thái"/>
                    <ComboBoxItem Content="Đang xử lý"/>
                    <ComboBoxItem Content="Hoàn thành"/>
                    <ComboBoxItem Content="Quá hạn"/>
                </ComboBox>

                <ComboBox Grid.Column="2" Width="150" Height="40" SelectedValuePath="Content" SelectedValue="{Binding SelectedPriorityFilter}" Style="{StaticResource ModernComboBox}">
                    <ComboBoxItem Content="Tất cả mức độ"/>
                    <ComboBoxItem Content="Cao"/>
                    <ComboBoxItem Content="Trung bình"/>
                    <ComboBoxItem Content="Thấp"/>
                </ComboBox>

                <ComboBox Grid.Column="4" Width="180" Height="40" ItemsSource="{Binding TechnicianList}" SelectedItem="{Binding SelectedTechnicianFilter}" Style="{StaticResource ModernComboBox}"/>

                <Button Grid.Column="7" Command="{Binding TriggerFilterCommand}" Height="40" Width="100" Padding="5 0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <fa:ImageAwesome Icon="Filter" Width="12" Height="12" Margin="0 0 6 0"/>
                        <TextBlock Text="Filter"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="6" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="0">
            <DataGrid Style="{StaticResource ModernDataGrid}"
                      ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                      RowStyle="{StaticResource ModernDataGridRow}"
                      CellStyle="{StaticResource ModernDataGridCell}"
                      ItemsSource="{Binding FilteredMaintenances}"
                      SelectedItem="{Binding SelectedMaintenance}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      RowHeight="64"
                      Background="White">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Thiết bị" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding TenThietBi}" FontWeight="SemiBold" FontSize="14" Foreground="#111827"/>
                                    <TextBlock Text="{Binding SoSeri, StringFormat='S/N: {0}'}" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Dịch vụ" Width="1.8*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TenDichVu}" Foreground="#2563EB" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Ngày đến hạn" Binding="{Binding NgayBaoTri, StringFormat=\{0:dd/MM/yyyy\}}" Width="1.2*" ElementStyle="{StaticResource CenterTextStyle}"/>

                    <DataGridTextColumn Header="Người được giao" Binding="{Binding TenNhanVien}" Width="1.3*" ElementStyle="{StaticResource CenterTextStyle}"/>

                    <DataGridTemplateColumn Header="Mức độ ưu tiên" Width="1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10 4" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DoUuTien}" Value="Cao">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DoUuTien}" Value="Trung bình">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DoUuTien}" Value="Thấp">
                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DoUuTien}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DoUuTien}" Value="Cao">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DoUuTien}" Value="Trung bình">
                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DoUuTien}" Value="Thấp">
                                                        <Setter Property="Foreground" Value="#059669"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Status" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10 4" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TinhTrangBaoTri}" Value="Quá hạn">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TinhTrangBaoTri}" Value="Đang xử lý">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TinhTrangBaoTri}" Value="Hoàn thành">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding TinhTrangBaoTri}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TinhTrangBaoTri}" Value="Quá hạn">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TinhTrangBaoTri}" Value="Đang xử lý">
                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TinhTrangBaoTri}" Value="Hoàn thành">
                                                        <Setter Property="Foreground" Value="#047857"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Thao tác" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                                    <Button Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        ToolTip="Chỉnh sửa"
                        Width="36" Height="36" Margin="0,0,8,0"
                        Background="#EFF6FF" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                        <fa:ImageAwesome Icon="Pencil" Width="16" Height="16" Foreground="#2563EB"/>
                                    </Button>

                                    <Button Command="{Binding DataContext.DeleteMaintenanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        ToolTip="Xóa"
                        Width="36" Height="36"
                        Background="#FEF2F2" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                        <fa:ImageAwesome Icon="Trash" Width="16" Height="16" Foreground="#DC2626"/>
                                    </Button>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
