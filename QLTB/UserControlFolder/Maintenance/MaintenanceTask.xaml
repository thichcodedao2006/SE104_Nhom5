<UserControl x:Class="QLTB.UserControlFolder.Maintenance.MaintenanceTask"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QLTB.UserControlFolder.Maintenance"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             Background="#F8FAFC">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="CÔNG VIỆC BẢO TRÌ"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#111827"/>

                <TextBlock Text="Theo dõi và quản lý các hoạt động bảo trì đã lên lịch"
                       Margin="0 6 0 0"
                       FontSize="14"
                       Foreground="#6B7280"/>
            </StackPanel>
        </Grid>

        <!-- STATISTICS CARDS -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- TOTAL TASKS -->
            <Border Grid.Column="0"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Tổng công việc"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0 0 0 10"/>

                        <TextBlock Text="{Binding TotalTasks}"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#111827"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                    Width="54"
                    Height="54"
                    Background="#DBEAFE"
                    CornerRadius="12">

                        <fa:ImageAwesome Icon="Tasks"
                                 Width="24"
                                 Height="24"
                                 Foreground="#2563EB"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- PENDING -->
            <Border Grid.Column="2"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Đang chờ"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0 0 0 10"/>

                        <TextBlock Text="{Binding PendingTasks}"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#F59E0B"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                    Width="54"
                    Height="54"
                    Background="#FEF3C7"
                    CornerRadius="12">

                        <fa:ImageAwesome Icon="ClockOutline"
                                 Width="24"
                                 Height="24"
                                 Foreground="#F59E0B"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- OVERDUE -->
            <Border Grid.Column="4"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Quá hạn"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0 0 0 10"/>

                        <TextBlock Text="{Binding OverdueTasks}"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#EF4444"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                    Width="54"
                    Height="54"
                    Background="#FEE2E2"
                    CornerRadius="12">

                        <fa:ImageAwesome Icon="ExclamationTriangle"
                                 Width="24"
                                 Height="24"
                                 Foreground="#EF4444"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- COMPLETED -->
            <Border Grid.Column="6"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Hoàn thành"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0 0 0 10"/>

                        <TextBlock Text="{Binding CompletedTasks}"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#10B981"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                    Width="54"
                    Height="54"
                    Background="#DCFCE7"
                    CornerRadius="12">

                        <fa:ImageAwesome Icon="CheckCircle"
                                 Width="24"
                                 Height="24"
                                 Foreground="#10B981"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- FILTERS -->
        <Border Grid.Row="4"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="14"
            Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Filter -->
                <ComboBox Grid.Column="0"
                      Width="150"
                      Height="40"
                      SelectedIndex="0"
                      Style="{StaticResource ModernComboBox}">
                    <ComboBoxItem Content="Tất cả trạng thái"/>
                    <ComboBoxItem Content="Đang chờ"/>
                    <ComboBoxItem Content="Đang tiến hành"/>
                    <ComboBoxItem Content="Hoàn thành"/>
                    <ComboBoxItem Content="Quá hạn"/>
                </ComboBox>

                <!-- Priority Filter -->
                <ComboBox Grid.Column="2"
                      Width="150"
                      Height="40"
                      SelectedIndex="0"
                      Style="{StaticResource ModernComboBox}">
                    <ComboBoxItem Content="Tất cả mức độ ưu tiên"/>
                    <ComboBoxItem Content="Cao"/>
                    <ComboBoxItem Content="Trung bình"/>
                    <ComboBoxItem Content="Thấp"/>
                </ComboBox>

                <!-- Technician Filter -->
                <ComboBox Grid.Column="4"
                      Width="180"
                      Height="40"
                      SelectedIndex="0"
                      Style="{StaticResource ModernComboBox}">
                    <ComboBoxItem Content="Tất cả kỹ thuật viên"/>
                    <ComboBoxItem Content="John Doe"/>
                    <ComboBoxItem Content="Jane Smith"/>
                    <ComboBoxItem Content="Bob Johnson"/>
                    <ComboBoxItem Content="Alice Brown"/>
                </ComboBox>

                <!-- More Filters Button -->
                <Button Grid.Column="6"
                    Height="40"
                    Padding="18 0"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    FontWeight="SemiBold"
                    Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Filter"
                                     Width="14"
                                     Height="14"
                                     Margin="0 0 8 0"/>
                        <TextBlock Text="Filter"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- TASKS TABLE -->
        <Border Grid.Row="6"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="14"
            Padding="0">

            <DataGrid Style="{StaticResource ModernDataGrid}"
                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                  RowStyle="{StaticResource ModernDataGridRow}"
                  CellStyle="{StaticResource ModernDataGridCell}"
                  ItemsSource="{Binding Tasks}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  BorderThickness="0"
                  GridLinesVisibility="Horizontal"
                  RowHeight="64"
                  Background="White">

                <DataGrid.Columns>

                    <!-- DEVICE -->
                    <DataGridTextColumn Header="Thiết bị"
                                    Binding="{Binding Device}"
                                    Width="1.5*"
                                    FontWeight="SemiBold"
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                   />

                    <!-- TYPE -->
                    <DataGridTemplateColumn Header="Loại"
                                        Width="1.8*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Type}"
                                       Foreground="#2563EB"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                                       
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- DUE DATE -->
                    <DataGridTextColumn Header="Ngày đến hạn"
                                    Binding="{Binding DueDate}"
                                    Width="1.2*"
                                    ElementStyle="{StaticResource CenterTextStyle}"/>

                    <!-- ASSIGNED TO -->
                    <DataGridTextColumn Header="Người được giao"
                                    Binding="{Binding AssignedTo}"
                                    Width="1.3*"
                                    ElementStyle="{StaticResource CenterTextStyle}"/>

                    <!-- PRIORITY -->
                    <DataGridTemplateColumn Header="Mức độ ưu tiên"
                                        Width="1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12"
                                    Padding="10 4"
                                    HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Priority}" Value="Cao">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Priority}" Value="Trung bình">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Priority}" Value="Thấp">
                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding Priority}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Cao">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Trung bình">
                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Thấp">
                                                        <Setter Property="Foreground" Value="#059669"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- STATUS -->
                    <DataGridTemplateColumn Header="Status"
                                        Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12"
                                    Padding="10 4"
                                    HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Quá hạn">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Đang chờ">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Đang tiến hành">
                                                    <Setter Property="Background" Value="#DBEAFE"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Hoàn thành">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding Status}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Quá hạn">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Đang chờ">
                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Đang tiến hành">
                                                        <Setter Property="Foreground" Value="#2563EB"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Hoàn thành">
                                                        <Setter Property="Foreground" Value="#047857"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- ACTION -->
                    <DataGridTemplateColumn Header="Action"
                                        Width="1.2*"
                                            >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✓ Hoàn thành"
                                    Command="{Binding DataContext.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource BlueButton}"
                                    Height="36"
                                    Padding="16 0"
                                    Background="#10B981"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    FontSize="13"
                                    Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
