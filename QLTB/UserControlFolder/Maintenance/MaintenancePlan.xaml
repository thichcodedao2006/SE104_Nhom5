<UserControl x:Class="QLTB.UserControlFolder.Maintenance.MaintenancePlan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QLTB.UserControlFolder.Maintenance"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             Background="#F8FAFC" >

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="KẾ HOẠCH BẢO TRÌ"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#111827"/>

                <TextBlock Text="Lập kế hoạch và quản lý các hoạt động bảo trì dự phòng"
                       Margin="0 6 0 0"
                       FontSize="14"
                       Foreground="#6B7280"/>
            </StackPanel>

            <Button Style="{StaticResource BlueButton}"
                Command="{Binding CreatePlanCommand}"
                Height="42"
                Padding="20 0"
                HorizontalAlignment="Right"
                Background="#2563EB"
                Foreground="White"
                BorderThickness="0"
                FontWeight="SemiBold"
                Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Plus"
                                 Width="14"
                                 Height="14"
                                 Foreground="White"
                                 Margin="0 0 8 0"/>
                    <TextBlock Text="Tạo kế hoạch"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- STATISTICS CARDS -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- TOTAL PLANS -->
            <Border Grid.Column="0"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Tổng kế hoạch"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0 0 0 10"/>

                        <TextBlock Text="{Binding TotalPlans}"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#111827"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                    Width="54"
                    Height="54"
                    Background="#DBEAFE"
                    CornerRadius="12">

                        <fa:ImageAwesome Icon="Clipboard"
                                 Width="24"
                                 Height="24"
                                 Foreground="#2563EB"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ACTIVE PLANS -->
            <Border Grid.Column="2"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Kế hoạch hoạt động"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0 0 0 10"/>

                        <TextBlock Text="{Binding ActivePlans}"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#10B981"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                    Width="54"
                    Height="54"
                    Background="#DCFCE7"
                    CornerRadius="12">

                        <fa:ImageAwesome Icon="CheckCircle"
                                 Width="24"
                                 Height="24"
                                 Foreground="#10B981"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- DUE THIS MONTH -->
            <Border Grid.Column="4"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Đến hạn trong tháng"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0 0 0 10"/>

                        <TextBlock Text="{Binding DueThisMonth}"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#F59E0B"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                    Width="54"
                    Height="54"
                    Background="#FEF3C7"
                    CornerRadius="12">

                        <fa:ImageAwesome Icon="ClockOutline"
                                 Width="24"
                                 Height="24"
                                 Foreground="#F59E0B"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ESTIMATED MONTHLY COST -->
            <Border Grid.Column="6"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Chi phí ước tính hàng tháng"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0 0 0 10"/>

                        <TextBlock FontSize="34"
                           FontWeight="Bold"
                           Foreground="#9333EA">

                    <Run Text="$"/>
                    <Run Text="{Binding EstimatedMonthlyCost}"/>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Column="1"
                    Width="54"
                    Height="54"
                    Background="#F3E8FF"
                    CornerRadius="12">

                        <fa:ImageAwesome Icon="Dollar"
                                 Width="24"
                                 Height="24"
                                 Foreground="#9333EA"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- VIEW TABS -->
        <Grid Grid.Row="4">
            <StackPanel Orientation="Horizontal">
                <Button Content="Danh sách"
                    Command="{Binding SwitchToListViewCommand}"
                    Height="36"
                    Padding="16 0"
                    Margin="0 0 8 0"
                    FontWeight="SemiBold"
                    Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#6B7280"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListView}" Value="True">
                                    <Setter Property="Foreground" Value="#2563EB"/>
                                    <Setter Property="BorderBrush" Value="#2563EB"/>
                                    <Setter Property="BorderThickness" Value="0 0 0 2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- PLANS LIST -->
        <ScrollViewer Grid.Row="6"
                  VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Plans}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="24"
                            Margin="0 0 0 16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- HEADER ROW -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#111827"/>
                                        <TextBlock Text="{Binding Equipment}"
                                               FontSize="14"
                                               Foreground="#2563EB"
                                               Margin="0 4 0 0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding EstimatedCost, StringFormat='Est. Cost $\{0\}'}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#111827"
                                               VerticalAlignment="Center"
                                               Margin="0 0 16 0"/>

                                        <Button Content="Xem chi tiết"
                                            Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource BlueButton}"
                                            Height="36"
                                            Padding="16 0"
                                            Background="#2563EB"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>

                                <!-- BADGES ROW -->
                                <StackPanel Grid.Row="2"
                                        Orientation="Horizontal">
                                    <!-- Priority Badge -->
                                    <Border CornerRadius="12"
                                        Padding="10 4"
                                        Margin="0 0 8 0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Cao">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Trung bình">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Thấp">
                                                        <Setter Property="Background" Value="#DBEAFE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding Priority}"
                                               FontSize="12"
                                               FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Priority}" Value="Cao">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Priority}" Value="Trung bình">
                                                            <Setter Property="Foreground" Value="#D97706"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Priority}" Value="Thấp">
                                                            <Setter Property="Foreground" Value="#2563EB"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Status Badge -->
                                    <Border CornerRadius="12"
                                        Padding="10 4"
                                        Background="#DCFCE7"
                                        Margin="0 0 8 0">
                                        <TextBlock Text="{Binding Status}"
                                               Foreground="#047857"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Type Badge -->
                                    <Border CornerRadius="12"
                                        Padding="10 4"
                                        Background="#F3F4F6"
                                        Margin="0 0 24 0">
                                        <TextBlock Text="{Binding Type}"
                                               Foreground="#374151"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Next Due -->
                                    <StackPanel Orientation="Horizontal"
                                            Margin="0 0 24 0">
                                        <fa:ImageAwesome Icon="Calendar"
                                                     Width="14"
                                                     Height="14"
                                                     Foreground="#6B7280"
                                                     VerticalAlignment="Center"
                                                     Margin="0 0 8 0"/>
                                        <StackPanel>
                                            <TextBlock Text="Đến hạn"
                                                   FontSize="11"
                                                   Foreground="#6B7280"/>
                                            <TextBlock Text="{Binding NextDue}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Schedule -->
                                    <StackPanel Orientation="Horizontal"
                                            Margin="0 0 24 0">
                                        <fa:ImageAwesome Icon="Refresh"
                                                     Width="14"
                                                     Height="14"
                                                     Foreground="#6B7280"
                                                     VerticalAlignment="Center"
                                                     Margin="0 0 8 0"/>
                                        <StackPanel>
                                            <TextBlock Text="Lịch trình"
                                                   FontSize="11"
                                                   Foreground="#6B7280"/>
                                            <TextBlock Text="{Binding Schedule}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Assigned To -->
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="User"
                                                     Width="14"
                                                     Height="14"
                                                     Foreground="#6B7280"
                                                     VerticalAlignment="Center"
                                                     Margin="0 0 8 0"/>
                                        <StackPanel>
                                            <TextBlock Text="Người được giao"
                                                   FontSize="11"
                                                   Foreground="#6B7280"/>
                                            <TextBlock Text="{Binding AssignedTo}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
