<UserControl x:Class="QLTB.UserControlFolder.Maintenance.MaintenanceHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QLTB.UserControlFolder.Maintenance"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             Background="#F8FAFC">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Maintenance History"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#111827"/>

                <TextBlock Text="View completed maintenance activities and records"
                       Margin="0 6 0 0"
                       FontSize="14"
                       Foreground="#6B7280"/>
            </StackPanel>
        </Grid>

        <!-- STATISTICS CARDS -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Records -->
            <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20">
                <StackPanel>
                    <TextBlock Text="Total Records"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0 0 0 8"/>
                    <TextBlock Text="{Binding TotalRecords}"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#111827"/>
                </StackPanel>
            </Border>

            <!-- This Month -->
            <Border Grid.Column="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20">
                <StackPanel>
                    <TextBlock Text="This Month"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0 0 0 8"/>
                    <TextBlock Text="{Binding ThisMonth}"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#2563EB"/>
                </StackPanel>
            </Border>

            <!-- Total Cost (YTD) -->
            <Border Grid.Column="4"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20">
                <StackPanel>
                    <TextBlock Text="Total Cost (YTD)"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0 0 0 8"/>
                    <TextBlock FontSize="32"
                           FontWeight="Bold"
                           Foreground="#111827">
                        <Run Text="$"/>
                        <Run Text="{Binding TotalCost}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Avg Cost per Task -->
            <Border Grid.Column="6"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20">
                <StackPanel>
                    <TextBlock Text="Avg Cost per Task"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0 0 0 8"/>
                    <TextBlock FontSize="32"
                           FontWeight="Bold"
                           Foreground="#111827">
                        <Run Text="$"/>
                        <Run Text="{Binding AvgCost}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SEARCH AND FILTERS -->
        <Border Grid.Row="4"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="14"
            Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Grid.Column="0"
                    Height="42"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <fa:ImageAwesome Icon="Search"
                                     Width="16"
                                     Height="16"
                                     Foreground="#6B7280"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             Foreground="#111827"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Column="1"
                               Text="Search by device, type, or technician..."
                               Foreground="#9CA3AF"
                               FontSize="14"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Time Filter -->
                <ComboBox Grid.Column="2"
                      Width="150"
                      Height="42"
                      SelectedIndex="0"
                      Style="{StaticResource ModernComboBox}">
                    <ComboBoxItem Content="All Time"/>
                    <ComboBoxItem Content="This Month"/>
                    <ComboBoxItem Content="Last Month"/>
                    <ComboBoxItem Content="Last 3 Months"/>
                    <ComboBoxItem Content="Last 6 Months"/>
                    <ComboBoxItem Content="This Year"/>
                </ComboBox>

                <!-- Export Button -->
                <Button Grid.Column="4"
                    Height="42"
                    Padding="18 0"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    FontWeight="SemiBold"
                    Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Download"
                                     Width="14"
                                     Height="14"
                                     Margin="0 0 8 0"/>
                        <TextBlock Text="Export"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- HISTORY TABLE -->
        <Border Grid.Row="6"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="14"
            Padding="0">

            <DataGrid Style="{StaticResource ModernDataGrid}"
                  ItemsSource="{Binding HistoryRecords}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  BorderThickness="0"
                  GridLinesVisibility="Horizontal"
                  RowHeight="64"
                  Background="White">

                <DataGrid.Columns>

                    <!-- DEVICE -->
                    <DataGridTextColumn Header="Device"
                                    Binding="{Binding Device}"
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                    Width="1.5*"
                                    FontWeight="SemiBold"
                                   />

                    <!-- TYPE -->
                    <DataGridTemplateColumn Header="Type"
                                        Width="1.8*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Type}"
                                       Foreground="#6B7280"
                                       VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- COMPLETED DATE -->
                    <DataGridTextColumn Header="Completed Date"
                                    Binding="{Binding CompletedDate}"
                                    Width="1.3*"
                                   />

                    <!-- TECHNICIAN -->
                    <DataGridTextColumn Header="Technician"
                                    Binding="{Binding Technician}"
                                    Width="1.2*"
                                   />

                    <!-- COST -->
                    <DataGridTemplateColumn Header="Cost"
                                        Width="1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontWeight="SemiBold"
                                       VerticalAlignment="Center">
                                    <Run Text="$"/>
                                    <Run Text="{Binding Cost}"/>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- ACTION -->
                    <DataGridTemplateColumn Header="Action"
                                        Width="1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource BlueButton}"
                                    Height="36"
                                    Padding="16 0"
                                    Background="#2563EB"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    FontSize="13"
                                    Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Eye"
                                                     Width="14"
                                                     Height="14"
                                                     Foreground="White"
                                                     Margin="0 0 6 0"
                                                     VerticalAlignment="Center"/>
                                        <TextBlock Text="View"
                                               VerticalAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
