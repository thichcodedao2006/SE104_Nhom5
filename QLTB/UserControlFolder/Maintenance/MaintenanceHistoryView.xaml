<UserControl x:Class="QLTB.UserControlFolder.Maintenance.MaintenanceHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QLTB.UserControlFolder.Maintenance"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             Background="#F8FAFC">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Lịch sử bảo trì"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#111827"/>

                <TextBlock Text="Xem các hoạt động và hồ sơ bảo trì đã hoàn thành"
                       Margin="0 6 0 0"
                       FontSize="14"
                       Foreground="#6B7280"/>
            </StackPanel>
        </Grid>

        <!-- STATISTICS CARDS -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Records -->
            <Border Grid.Column="0"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Tổng số bản ghi"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0 0 0 10"/>

                        <TextBlock Text="{Binding TotalRecords}"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#111827"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                    Width="54"
                    Height="54"
                    Background="#DBEAFE"
                    CornerRadius="12">

                        <fa:ImageAwesome Icon="Database"
                                 Width="24"
                                 Height="24"
                                 Foreground="#2563EB"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- THIS MONTH -->
            <Border Grid.Column="2"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Tháng này"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0 0 0 10"/>

                        <TextBlock Text="{Binding ThisMonth}"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#16A34A"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                    Width="54"
                    Height="54"
                    Background="#DCFCE7"
                    CornerRadius="12">

                        <fa:ImageAwesome Icon="Calendar"
                                 Width="24"
                                 Height="24"
                                 Foreground="#16A34A"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- TOTAL COST -->
            <Border Grid.Column="4"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Tổng chi phí"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0 0 0 10"/>

                        <TextBlock FontSize="34"
                           FontWeight="Bold"
                           Foreground="#D97706">

                    <Run Text="$"/>
                    <Run Text="{Binding TotalCost}"/>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Column="1"
                    Width="54"
                    Height="54"
                    Background="#FEF3C7"
                    CornerRadius="12">

                        <fa:ImageAwesome Icon="Dollar"
                                 Width="24"
                                 Height="24"
                                 Foreground="#D97706"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- AVG COST -->
            <Border Grid.Column="6"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="16"
            Padding="22">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Trung bình mỗi nhiệm vụ"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0 0 0 10"/>

                        <TextBlock FontSize="34"
                           FontWeight="Bold"
                           Foreground="#9333EA">

                    <Run Text="$"/>
                    <Run Text="{Binding AvgCost}"/>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Column="1"
                    Width="54"
                    Height="54"
                    Background="#F3E8FF"
                    CornerRadius="12">

                        <fa:ImageAwesome Icon="BarChart"
                                 Width="24"
                                 Height="24"
                                 Foreground="#9333EA"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

        </Grid>

        <!-- SEARCH AND FILTERS -->
        <Border Grid.Row="4"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="14"
            Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Grid.Column="0"
                    Height="42"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <fa:ImageAwesome Icon="Search"
                                     Width="16"
                                     Height="16"
                                     Foreground="#6B7280"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             Foreground="#111827"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Column="1"
                               Text="Tìm kiếm theo thiết bị, loại, hoặc kỹ thuật viên..."
                               Foreground="#9CA3AF"
                               FontSize="14"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Time Filter -->
                <ComboBox Grid.Column="2"
                      Width="150"
                      Height="42"
                      SelectedIndex="0"
                      Style="{StaticResource ModernComboBox}">
                    <ComboBoxItem Content="Tất cả thời gian"/>
                    <ComboBoxItem Content="Tháng này"/>
                    <ComboBoxItem Content="Tháng trước"/>
                    <ComboBoxItem Content="3 Tháng trước"/>
                    <ComboBoxItem Content="6 Tháng trước"/>
                    <ComboBoxItem Content="Năm nay"/>
                </ComboBox>

                <!-- Export Button -->
                <Button Grid.Column="4"
                    Height="42"
                    Padding="18 0"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    FontWeight="SemiBold"
                    Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Download"
                                     Width="14"
                                     Height="14"
                                     Margin="0 0 8 0"/>
                        <TextBlock Text="Xuất file"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- HISTORY TABLE -->
        <Border Grid.Row="6"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="14"
            Padding="0">

            <DataGrid Style="{StaticResource ModernDataGrid}"
                  ItemsSource="{Binding HistoryRecords}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  BorderThickness="0"
                  GridLinesVisibility="Horizontal"
                  RowHeight="64"
                  Background="White"
                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                  RowStyle="{StaticResource ModernDataGridRow}"
                  CellStyle="{StaticResource ModernDataGridCell}">

                <DataGrid.Columns>

                    <!-- DEVICE -->
                    <DataGridTextColumn Header="Thiết bị"
                                    Binding="{Binding Device}"
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                    Width="1.5*"
                                    FontWeight="SemiBold"
                                   />

                    <!-- TYPE -->
                    

                    <!-- COMPLETED DATE -->
                    <DataGridTextColumn Header="Ngày hoàn thành"
                                    Binding="{Binding CompletedDate}"
                                    Width="1.3*"
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                   />

                    <!-- TECHNICIAN -->
                    <DataGridTextColumn Header="Kỹ thuật viên"
                                    Binding="{Binding Technician}"
                                    Width="1.2*"
                                    ElementStyle="{StaticResource CenterTextStyle}"
                                   />

                    <!-- COST -->
                    <DataGridTemplateColumn Header="Chi phí"
                                        Width="1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center">
                                    <Run Text="$"/>
                                    <Run Text="{Binding Cost}"/>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- ACTION -->
                    <DataGridTemplateColumn Header="Hành động"
                                        Width="1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource BlueButton}"
                                    Height="36"
                                    Padding="16 0"
                                    Background="#2563EB"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    FontSize="13"
                                    Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <fa:ImageAwesome Icon="Eye"
                                                     Width="14"
                                                     Height="14"
                                                     Foreground="White"
                                                     Margin="0 0 6 0"
                                                     VerticalAlignment="Center"/>
                                        <TextBlock Text="Xem"
                                               VerticalAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
