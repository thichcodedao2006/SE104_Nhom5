<UserControl x:Class="QLTB.UserControlFolder.Maintenance.MaintenanceEditFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             Background="Transparent">

    <Border Width="650" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="16" Padding="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" Direction="-90" RenderingBias="Quality" ShadowDepth="3" Opacity="0.15"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="CẬP NHẬT CÔNG VIỆC BẢO TRÌ" FontSize="22" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Thiết bị bảo trì" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                    <TextBox Style="{StaticResource RoundedTextBox}" Height="40" IsReadOnly="True" Background="#F3F4F6" Foreground="#6B7280" Padding="10,0" VerticalContentAlignment="Center" Text="{Binding DeviceName}"/>

                    <TextBlock Text="Dịch vụ bảo trì" FontWeight="SemiBold" Margin="0,15,0,8" Foreground="#374151"/>
                    <ComboBox Style="{StaticResource ModernComboBox}" Height="40" 
                              ItemsSource="{Binding ServiceList}" 
                              SelectedValue="{Binding SelectedServiceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                              DisplayMemberPath="TenDichVu" 
                              SelectedValuePath="IddichVu"/>

                    <TextBlock Text="Ngày bảo trì" FontWeight="SemiBold" Margin="0,15,0,8" Foreground="#374151"/>
                    <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Background="White" Height="40" Padding="4,0">
                        <DatePicker SelectedDate="{Binding NgayBaoTri, Mode=TwoWay}" BorderThickness="0" VerticalAlignment="Center">
                            <DatePicker.Resources>
                                <Style TargetType="DatePickerTextBox">
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </DatePicker.Resources>
                        </DatePicker>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Số Serial" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                    <TextBox Style="{StaticResource RoundedTextBox}" Height="40" Padding="10,0" VerticalContentAlignment="Center" Tag="Nhập số serial" Text="{Binding SelectedSerial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Người thực hiện (Kỹ thuật viên)" FontWeight="SemiBold" Margin="0,15,0,8" Foreground="#374151"/>
                    <ComboBox Style="{StaticResource ModernComboBox}" Height="40" 
                              ItemsSource="{Binding StaffList}" 
                              SelectedValue="{Binding SelectedStaffId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                              DisplayMemberPath="HoTen" 
                              SelectedValuePath="IdnhanVien"/>

                    <TextBlock Text="Mức ưu tiên" FontWeight="SemiBold" Margin="0,15,0,8" Foreground="#374151"/>
                    <ComboBox Style="{StaticResource ModernComboBox}" Height="40" SelectedValue="{Binding DoUuTien, Mode=TwoWay}" SelectedValuePath="Content">
                        <ComboBoxItem Content="Cao"/>
                        <ComboBoxItem Content="Trung bình"/>
                        <ComboBoxItem Content="Thấp"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Text="Trạng thái công việc" FontWeight="SemiBold" Margin="0,15,0,8" Foreground="#374151"/>
            <ComboBox Style="{StaticResource ModernComboBox}" Height="40" SelectedValue="{Binding TinhTrangBaoTri, Mode=TwoWay}" SelectedValuePath="Content">
                <ComboBoxItem Content="Đang xử lý"/>
                <ComboBoxItem Content="Hoàn thành"/>
                <ComboBoxItem Content="Quá hạn"/>
            </ComboBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
                <Button Content="Hủy bỏ" Width="100" Height="40" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,0,12,0" Cursor="Hand" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Lưu thay đổi" Width="130" Height="40" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>