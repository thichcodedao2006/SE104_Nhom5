        <Border
            Background="White"
            CornerRadius="30"
            ></Border>
        <TextBlock
            Width="200"
            Height="50"
            FontWeight="SemiBold"
            TextAlignment="Center"
            FontSize="15"
            VerticalAlignment="Top"
            Margin="0 25 0 0"
            >
            Nhập mã OTP
            <LineBreak></LineBreak>
            (Mã đã được gửi qua email)
        </TextBlock>
