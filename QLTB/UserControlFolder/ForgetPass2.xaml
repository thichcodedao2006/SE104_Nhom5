        <ItemsControl ItemsSource="{Binding Data.OtpList}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" 
                                Margin="0 -50 0 0"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="60" Height="80" Margin="5" Background="#E5EEFF" CornerRadius="10">

                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                         MaxLength="1" 
                         IsEnabled="{Binding IsEnable, UpdateSourceTrigger=PropertyChanged}"         
                         FontSize="25"
                         Height= "50"
                         Width="40"
                         Foreground="Blue"
                         FontWeight="Bold"
                         TextAlignment="Center"
                         VerticalAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         TextChanged="TextBox_TextChanged"
                          >
                            <i:Interaction.Behaviors>
                                <con:PhoneCondition></con:PhoneCondition>
                            </i:Interaction.Behaviors>
                        </TextBox>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>
        <StackPanel
            Height="30"
            Width="200"
            Margin="0 65 0 0"
            Orientation="Horizontal"
            >
            <TextBlock
    Height="20"
    Width="130"
    Text="Chưa nhận được email?"
                Foreground="Gray"
                Margin="20 0 0 0"
    ></TextBlock>
            <TextBlock
                Height="20"
                Width="50"
                
                Foreground="#145CC6"
                FontWeight="SemiBold"
                >
                <Hyperlink > Gửi lại</Hyperlink>
            </TextBlock>
        </StackPanel>
        <Button
Width="150"
Height="50"
Content="Xác nhận"
FontSize="15"
Margin="0 200 80 0"
            HorizontalAlignment="Right"
Style="{StaticResource PrimaryButtonStyle}"
            Command="{Binding NextCommand}"
>

        </Button>
        <Button
Width="150"
Height="50"
Content="Trở lại trang trước"
FontSize="15"
Margin="80 200 0 0"
            HorizontalAlignment="Left"
Style="{StaticResource SecondaryButtonStyle}"
            Command="{Binding BackCommand}"
>

        </Button>
    </Grid>
</UserControl>
