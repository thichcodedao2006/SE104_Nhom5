<UserControl x:Class="QLTB.UserControlFolder.Device.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QLTB.UserControlFolder.Device"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             Background="#F8FAFC" >

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Quản lý thiết bị"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#111827"/>

                <TextBlock Text="Theo dõi và quản lý tài sản thiết bị trong hệ thống"
                       Margin="0 6 0 0"
                       FontSize="14"
                       Foreground="#6B7280"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">


                <Button Style="{StaticResource BlueButton}"
                    Height="42"
                    Padding="18 0"
                    Margin="0 0 12 0"
                    Background="#6699FF"
                    BorderBrush="#6699FF"
                    BorderThickness="1"
                    Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Upload"
                                     Width="14"
                                     Height="14"
                                     Margin="0 0 8 0"/>
                        <TextBlock Text="Nhập file"
                               Foreground="Black"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BlueButton}"
                     Height="42"
                     Padding="18 0"
                     Margin="0 0 12 0"
                     Background="#6699FF"
                     BorderBrush="#E5E7EB"
                     BorderThickness="1"
                     Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Download"
                      Width="14"
                      Height="14"
                      Margin="0 0 8 0"/>
                        <TextBlock Text="Xuất file"
                Foreground="Black"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource BeautyButton}"
                    Height="42"
                    Padding="20 0"
                    Background="#8B5CF6"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <fa:ImageAwesome Icon="Plus"
                                     Width="14"
                                     Height="14"
                                     Foreground="White"
                                     Margin="0 0 8 0"/>
                        <TextBlock Text="Thêm thiết bị"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- CARD -->
        <Border Grid.Row="2"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="16"
            Padding="24">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- SEARCH -->
                <Grid Grid.Row="0">
                    <Border Width="450"
                        Height="42"
                        HorizontalAlignment="Left"
                        Background="White"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="12">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <fa:ImageAwesome Icon="Search"
                                         Width="15"
                                         Height="15"
                                         Foreground="#6B7280"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>

                            <TextBox Grid.Column="1"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 Foreground="#111827"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Column="1"
                                   Text="Tìm kiếm thiết bị..."
                                   Foreground="#9CA3AF"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">

                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- VIEW MODE BUTTONS -->
                    <Border HorizontalAlignment="Right"
                        Width="86"
                        Height="42"
                        Background="#F3F4F6"
                        CornerRadius="18"
                        Padding="4">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                Background="White"
                                BorderThickness="0"
                                Cursor="Hand">
                                <fa:ImageAwesome Icon="List"
                                             Width="15"
                                             Height="15"
                                             Foreground="#111827"/>
                            </Button>

                            <Button Grid.Column="1"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                                <fa:ImageAwesome Icon="Th"
                                             Width="15"
                                             Height="15"
                                             Foreground="#111827"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TABLE -->
                <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedDevice}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="White"
                      RowHeight="72">

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="THIẾT BỊ" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                        <Border Width="42"
                                            Height="42"
                                            Background="#D946EF"
                                            CornerRadius="21"
                                            Margin="0 0 12 0">
                                            <fa:ImageAwesome Icon="Desktop"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="White"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="#111827"/>

                                            <TextBlock Text="{Binding Model}"
                                                   Margin="0 4 0 0"
                                                   FontSize="12"
                                                   Foreground="#6B7280"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="SERIAL"
                                        Binding="{Binding Serial}"
                                        Width="1.5*"/>
                        <DataGridTextColumn Header="MÃ"
                                        Binding="{Binding Manufacturer}"
                                        Width="1.5*"/>

                        <DataGridTextColumn Header="PHÒNG BAN"
                                        Binding="{Binding Department}"
                                        Width="1.3*"/>

                        <DataGridTextColumn Header="VỊ TRÍ"
                                        Binding="{Binding Location}"
                                        Width="1.6*"/>

                        <DataGridTemplateColumn Header="TRẠNG THÁI" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12"
                                        Padding="10 4"
                                        Background="#DCFCE7"
                                        HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Status}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#047857"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="BẢO HÀNH"
                                        Binding="{Binding WarrantyDate}"
                                        Width="1.2*"/>
                        <DataGridTemplateColumn Header="THAO TÁC"
                                Width="1*">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal">

                                        <Button Width="32"
                                                Height="32"
                                                Background="Transparent"
                                                BorderThickness="0">

                                            <fa:ImageAwesome Icon="Edit"
                                                             Width="14"
                                                             Height="14"
                                                             Foreground="#6B7280"/>
                                        </Button>
                                        
                                        <Button Width="32"
                                                Height="32"
                                                Background="Transparent"
                                                BorderThickness="0">

                                            <fa:ImageAwesome Icon="Trash"
                                                             Width="14"
                                                             Height="14"
                                                             Foreground="#6B7280"/> 
                                        </Button>

                                    </StackPanel>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
