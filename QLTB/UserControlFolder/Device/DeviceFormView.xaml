<UserControl x:Class="QLTB.UserControlFolder.Device.DeviceFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QLTB.UserControlFolder.Device"
             xmlns:helpers="clr-namespace:QLTB.Helpers"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             Background="Transparent">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Width="650" Background="{StaticResource MainBackgroundBrush}" CornerRadius="16" Padding="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Opacity="0.12"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="Cập nhật kho thiết bị" FontSize="22" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,15"/>

            <GroupBox Header="1. THÔNG TIN CHUNG THIẾT BỊ " FontSize="13" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,15" Padding="10,10,10,15">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tên thiết bị" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource RoundedTextBox}" Height="38" Padding="10,0" VerticalContentAlignment="Center" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditMode}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Nhà sản xuất" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource RoundedTextBox}" Height="38" Padding="10,0" VerticalContentAlignment="Center" Text="{Binding Manufacturer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditMode}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Loại thiết bị" FontWeight="SemiBold" Foreground="#374151" Margin="0,12,0,6"/>
                    <ComboBox Style="{StaticResource ModernComboBox}" Height="38" IsEditable="True"
                              ItemsSource="{Binding CategoryList}" 
                              Text="{Binding SelectedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="2. THÔNG TIN ĐỊNH DANH CHI TIẾT " FontSize="13" FontWeight="Bold" Foreground="#059669" Margin="0,0,0,10" Padding="10,10,10,15">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Cách 1: Nhập thủ công" VerticalAlignment="Center" FontStyle="Italic" Foreground="#6B7280" Visibility="{Binding IsNewDevice, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Cách 2: Import CSV" HorizontalAlignment="Right" Width="180" Height="32" Background="#ECFDF5" Foreground="#059669" FontWeight="SemiBold" BorderBrush="#A7F3D0" Command="{Binding ImportFileCommand}" Cursor="Hand" Visibility="{Binding IsNewDevice, Converter={StaticResource BoolToVis}}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Số Serial" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource RoundedTextBox}" Height="38" Padding="10,0" VerticalContentAlignment="Center" Text="{Binding Serial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditMode}"/>

                            <TextBlock Text="Trạng thái" FontWeight="SemiBold" Foreground="#374151" Margin="0,12,0,6"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" Height="38" SelectedValue="{Binding Status, Mode=TwoWay}" SelectedValuePath="Content">
                                <ComboBoxItem Content="Đang hoạt động"/>
                                <ComboBoxItem Content="Đang bảo trì"/>
                                <ComboBoxItem Content="Ngừng hoạt động"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Phòng Ban phân bổ" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" Height="38" 
                                      ItemsSource="{Binding PhongBanList}" 
                                      DisplayMemberPath="TenPhong" 
                                      SelectedValuePath="Idphong" 
                                      SelectedValue="{Binding SelectedPhongBanId, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Hủy bỏ" Width="100" Height="38" Background="White" BorderBrush="#D1D5DB" Margin="0,0,12,0" Cursor="Hand" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Xác nhận Lưu" Width="130" Height="38" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>