<UserControl x:Class="QLTB.UserControlFolder.Device.DeviceFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QLTB.UserControlFolder.Device"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             Background="Transparent">
    <UserControl.Resources>
        <BoolToVisibilityConverter xmlns="clr-namespace:QLTB.Helpers" x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <Border Width="650"
            Background="White"
            CornerRadius="12"
            Padding="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="-90" RenderingBias="Quality" ShadowDepth="1" Opacity="0.1"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="Thêm thiết bị mới" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="#111827" 
                       Margin="0,0,0,20"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tên thiết bị" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource RoundedTextBox}" Height="40" Padding="10,0" VerticalContentAlignment="Center" 
                             Tag="Nhập tên thiết bị" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Mã tài sản" FontWeight="SemiBold" Margin="0,15,0,8"/>
                    <TextBox Style="{StaticResource RoundedTextBox}" Height="40" Padding="10,0" VerticalContentAlignment="Center" 
                             Tag="Nhập mã tài sản" Text="{Binding AssetCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Nhà sản xuất" FontWeight="SemiBold" Margin="0,15,0,8"/>
                    <TextBox Style="{StaticResource RoundedTextBox}" Height="40" Padding="10,0" VerticalContentAlignment="Center" 
                             Tag="Nhập nhà sản xuất" Text="{Binding Manufacturer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Vị trí" FontWeight="SemiBold" Margin="0,15,0,8"/>
                    <TextBox Style="{StaticResource RoundedTextBox}" Height="40" Padding="10,0" VerticalContentAlignment="Center" 
                             Tag="Nhập vị trí" Text="{Binding Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Số Serial" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource RoundedTextBox}" Height="40" Padding="10,0" VerticalContentAlignment="Center" 
                             Tag="Nhập số serial" Text="{Binding Serial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Model" FontWeight="SemiBold" Margin="0,15,0,8"/>
                    <TextBox Style="{StaticResource RoundedTextBox}" Height="40" Padding="10,0" VerticalContentAlignment="Center" 
                             Tag="Nhập model" Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Phòng ban" FontWeight="SemiBold" Margin="0,15,0,8"/>
                    <TextBox Style="{StaticResource RoundedTextBox}" Height="40" Padding="10,0" VerticalContentAlignment="Center" 
                             Tag="Nhập phòng ban" Text="{Binding Department, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Trạng thái" FontWeight="SemiBold" Margin="0,15,0,8"/>
                    <ComboBox Style="{StaticResource ModernComboBox}" Height="40" SelectedIndex="0"
                              SelectedValue="{Binding Status, Mode=TwoWay}" 
                              SelectedValuePath="Content">
                        <ComboBoxItem Content="Đang hoạt động"/>
                        <ComboBoxItem Content="Đang bảo trì"/>
                        <ComboBoxItem Content="Ngừng hoạt động"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Text="Hình ảnh thiết bị" FontWeight="SemiBold" Margin="0,20,0,8"/>
            <Border Height="150" BorderBrush="#D1D5DB" BorderThickness="1.5" CornerRadius="8" Background="#F9FAFB">
                <Grid>
                    <Image Source="{Binding ImagePath}" Stretch="Uniform" Margin="8">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ImagePath}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ImagePath, Converter={StaticResource BoolToVisibility}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImagePath, Converter={StaticResource BoolToVisibility}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <fa:ImageAwesome Icon="Image" Width="40" Height="40" Foreground="#6B7280" Margin="0,0,0,10"/>
                        <TextBlock Text="Kéo thả ảnh hoặc click để chọn" Foreground="#6B7280" HorizontalAlignment="Center"/>
                        <Button Content="Chọn tệp" Margin="0,10,0,0" Width="100" Height="32" 
                Background="#F3F4F6" BorderBrush="#D1D5DB"
                Command="{Binding SelectImageCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
                <Button Content="Hủy bỏ" Width="100" Height="40" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" 
                        Margin="0,0,12,0" Cursor="Hand" 
                        Command="{Binding CancelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Button Content="Thêm thiết bị" Width="130" Height="40" Background="#2563EB" Foreground="White" 
                        FontWeight="Bold" BorderThickness="0" Cursor="Hand" 
                        Command="{Binding SaveCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>