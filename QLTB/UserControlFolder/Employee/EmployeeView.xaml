<UserControl x:Class="QLTB.UserControlFolder.Employee.EmployeeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QLTB.UserControlFolder.Employee"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:vm="clr-namespace:QLTB.ViewModel"
         Background="#F8FAFC">

    <UserControl.DataContext>
        <vm:EmployeeViewModel/>
    </UserControl.DataContext>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Hàng 1: Header -->
            <RowDefinition Height="150"/>
            <!-- Hàng 2: Summary Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Hàng 3: Filter/Search -->
            <RowDefinition Height="*"/>
            <!-- Hàng 4: Employee Cards -->
        </Grid.RowDefinitions>

        <!-- Hàng 1: Header -->
        <Grid Grid.Row="0" Margin="0 0 0 24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="QUẢN LÝ NHÂN VIÊN" FontSize="26" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="Quản lý kỹ thuật và nhân viên bảo trì" FontSize="14" Foreground="#6B7280" Margin="0 6 0 0"/>
            </StackPanel>

            <Button 
                
                Grid.Column="1" Style="{StaticResource BlueButton}" Height="42" Padding="22 0" Command="{Binding AddEmployeeCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="➕" Margin="0 0 8 0"/>
                    <TextBlock Text="Thêm nhân viên"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Hàng 2: Summary Cards -->
        <Grid Grid.Row="1" Margin="0 0 0 24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: Total Employees -->
            <Border Style="{StaticResource CardStyle}" Margin="0 0 24 0" Grid.Column="0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Số nhân viên" FontSize="15" Foreground="#374151"/>
                        <TextBlock Text="{Binding TotalEmployees, UpdateSourceTrigger=PropertyChanged}" FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0 12 0 0"/>
                    </StackPanel>
                    <Border Width="48" Height="48" Background="#DBEAFE" CornerRadius="8"
                HorizontalAlignment="Right" VerticalAlignment="Top">
                        <fa:ImageAwesome Icon="Users" Width="24" Height="24" Foreground="#2563EB"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Column 2: Active Employees -->
            <Border Style="{StaticResource CardStyle}" Margin="0 0 24 0" Grid.Column="1" >


                <Grid>
                    <StackPanel>
                        <TextBlock Text="Hoạt động" FontSize="15" Foreground="#374151"/>
                        <TextBlock Text="{Binding ActiveEmployees, UpdateSourceTrigger=PropertyChanged}" FontSize="24" FontWeight="Bold" Foreground="#16A34A" Margin="0 12 0 0"/>
                    </StackPanel>
                    <Border Width="48" Height="48" Background="#DCFCE7" CornerRadius="8"
                HorizontalAlignment="Right" VerticalAlignment="Top">
                        <fa:ImageAwesome Icon="CheckCircle" Width="24" Height="24" Foreground="#16A34A"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Column 3: Departments -->
            <Border Style="{StaticResource CardStyle}" Margin="0 0 24 0" Grid.Column="2">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Bộ phận" FontSize="15" Foreground="#374151"/>
                        <TextBlock Text="{Binding DepartmentsCount, UpdateSourceTrigger=PropertyChanged}" FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0 12 0 0"/>
                    </StackPanel>
                    <Border Width="48" Height="48" Background="#DBEAFE" CornerRadius="8"
                HorizontalAlignment="Right" VerticalAlignment="Top">
                        <fa:ImageAwesome Icon="Building" Width="24" Height="24" Foreground="#2563EB"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Column 4: Roles -->
            <Border Style="{StaticResource CardStyle}" Grid.Column="3">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Chức danh" FontSize="15" Foreground="#374151"/>
                        <TextBlock Text="{Binding RolesCount, UpdateSourceTrigger=PropertyChanged}" FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0 12 0 0"/>
                    </StackPanel>
                    <Border Width="48" Height="48" Background="#DBEAFE" CornerRadius="8"
                HorizontalAlignment="Right" VerticalAlignment="Top">
                        <fa:ImageAwesome Icon="User" Width="24" Height="24" Foreground="#2563EB"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Hàng 3: Filter/Search -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Thanh tìm kiếm (giãn theo không gian còn lại) -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>

                <!-- ComboBox chọn tiêu chí lọc -->
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="16"/>

                <!-- Button Bộ lọc -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 1. THANH TÌM KIẾM (Grid.Column mặc định là 0) -->
            <Border Height="44"
            Background="White"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <fa:ImageAwesome Icon="Search"
                             Width="15"
                             Height="15"
                             Foreground="#6B7280"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                     BorderThickness="0"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     FontSize="14"
                     Foreground="#111827"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Column="1"
                       Text="Tìm kiếm..."
                       Foreground="#9CA3AF"
                       FontSize="14"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- 2. COMBOBOX CHỌN TIÊU CHÍ (Grid.Column="2") -->
            <ComboBox 
                Style="{StaticResource ModernComboBox}"
                SelectedValuePath="Content"
                Grid.Column="2"
              Height="44"
              FontSize="14"
              Background="White"
              BorderBrush="#D1D5DB"
              VerticalContentAlignment="Center"
              Padding="10 0"
              Cursor="Hand"
              SelectedIndex="0"
                SelectedValue="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <!-- SelectedIndex="0" để chọn sẵn item đầu tiên -->

                <!-- Các lựa chọn mẫu, bạn có thể Bind dữ liệu từ ViewModel vào -->
                <ComboBoxItem Content="Tên nhân viên"/>
                <ComboBoxItem Content="Tình trạng"/>
                <ComboBoxItem Content="Bộ phận"/>
                <ComboBoxItem Content="Chức vụ"/>
                <ComboBoxItem Content="Xác thực của tài khoản"/>
            </ComboBox>

            <!-- 3. BUTTON BỘ LỌC (Grid.Column="4") -->
            <Button Grid.Column="4"
            Style="{StaticResource BeautyButton}"
            Height="44"
            Padding="18 0"
            Background="White"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            FontWeight="SemiBold"
            Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <fa:ImageAwesome Icon="Filter"
                             Width="14"
                             Height="14"
                             Margin="0 0 8 0"/>
                    <TextBlock Text="Bộ lọc"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Hàng 4: Employee Cards -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredEmployees}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" HorizontalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Width="280" Height="220" Margin="8">
                            <StackPanel Margin="12">

                                <Grid VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="36" Height="36" Fill="#E0E7FF"/>

                                    <StackPanel Grid.Column="1" Margin="8 0 10 0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HoTen}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ChucDanh}" FontSize="12" Foreground="#6B7280" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" 
                       Text="{Binding TinhTrang}" 
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{Binding StatusColor}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0 4 0 0"/>
                                </Grid>
                                <StackPanel Margin="0 12 0 0">
                                    <StackPanel Orientation="Horizontal" Margin="0 2 0 0">
                                        <TextBlock Text="✉ " FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock Text="{Binding Email}" FontSize="12" Foreground="#6B7280"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0 2 0 0">
                                        <TextBlock Text="📞 " FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock Text="{Binding Sdt}" FontSize="12" Foreground="#6B7280"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0 2 0 0">
                                        <TextBlock Text="📁 " FontSize="12" Foreground="#FBBF24"/>
                                        <TextBlock Text="{Binding BoPhan}" FontSize="12" Foreground="#FBBF24"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0 12 0 0">
                                    <Button Content="Chỉnh sửa" Style="{StaticResource BlueButton}" Width="160" Height="32"
                Command="{Binding DataContext.EditEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"/>
                                    <Button Content="🗑" Background="#FEE2E2" Foreground="#B91C1C" Width="32" Height="32" Margin="8 0 0 0"
                Command="{Binding DataContext.DeleteEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
