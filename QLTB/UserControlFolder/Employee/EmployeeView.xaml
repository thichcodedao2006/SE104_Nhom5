<UserControl x:Class="QLTB.UserControlFolder.Employee.EmployeeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QLTB.UserControlFolder.Employee"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:vm="clr-namespace:QLTB.ViewModel"
         Background="#F3F4F6">

    <UserControl.DataContext>
        <vm:EmployeeViewModel/>
    </UserControl.DataContext>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Hàng 1: Header -->
            <RowDefinition Height="150"/>
            <!-- Hàng 2: Summary Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Hàng 3: Filter/Search -->
            <RowDefinition Height="*"/>
            <!-- Hàng 4: Employee Cards -->
        </Grid.RowDefinitions>

        <!-- Hàng 1: Header -->
        <Grid Grid.Row="0" Margin="0 0 0 24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="QUẢN LÝ NHÂN VIÊN" FontSize="26" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="Quản lý kỹ thuật và nhân viên bảo trì" FontSize="14" Foreground="#6B7280" Margin="0 6 0 0"/>
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource BlueButton}" Height="42" Padding="22 0" Command="{Binding AddEmployeeCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="➕" Margin="0 0 8 0"/>
                    <TextBlock Text="Thêm nhân viên"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Hàng 2: Summary Cards -->
        <Grid Grid.Row="1" Margin="0 0 0 24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: Total Employees -->
            <Border Style="{StaticResource CardStyle}" Margin="0 0 24 0" Grid.Column="0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Số nhân viên" FontSize="15" Foreground="#374151"/>
                        <TextBlock Text="{Binding TotalEmployees}" FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0 12 0 0"/>
                    </StackPanel>
                    <Border Width="48" Height="48" Background="#DBEAFE" CornerRadius="8"
                HorizontalAlignment="Right" VerticalAlignment="Top">
                        <fa:ImageAwesome Icon="Users" Width="24" Height="24" Foreground="#2563EB"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Column 2: Active Employees -->
            <Border Style="{StaticResource CardStyle}" Margin="0 0 24 0" Grid.Column="1" >


                <Grid>
                    <StackPanel>
                        <TextBlock Text="Hoạt động" FontSize="15" Foreground="#374151"/>
                        <TextBlock Text="{Binding ActiveEmployees}" FontSize="24" FontWeight="Bold" Foreground="#16A34A" Margin="0 12 0 0"/>
                    </StackPanel>
                    <Border Width="48" Height="48" Background="#DCFCE7" CornerRadius="8"
                HorizontalAlignment="Right" VerticalAlignment="Top">
                        <fa:ImageAwesome Icon="CheckCircle" Width="24" Height="24" Foreground="#16A34A"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Column 3: Departments -->
            <Border Style="{StaticResource CardStyle}" Margin="0 0 24 0" Grid.Column="2">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Bộ phận" FontSize="15" Foreground="#374151"/>
                        <TextBlock Text="{Binding DepartmentsCount}" FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0 12 0 0"/>
                    </StackPanel>
                    <Border Width="48" Height="48" Background="#DBEAFE" CornerRadius="8"
                HorizontalAlignment="Right" VerticalAlignment="Top">
                        <fa:ImageAwesome Icon="Building" Width="24" Height="24" Foreground="#2563EB"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Column 4: Roles -->
            <Border Style="{StaticResource CardStyle}" Grid.Column="3">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Vai trò" FontSize="15" Foreground="#374151"/>
                        <TextBlock Text="{Binding RolesCount}" FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0 12 0 0"/>
                    </StackPanel>
                    <Border Width="48" Height="48" Background="#DBEAFE" CornerRadius="8"
                HorizontalAlignment="Right" VerticalAlignment="Top">
                        <fa:ImageAwesome Icon="User" Width="24" Height="24" Foreground="#2563EB"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Hàng 3: Filter/Search -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 0 0 24">
            <TextBox Width="400" Height="36" Padding="12" FontSize="14"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 BorderBrush="#D1D5DB"
                 Background="White"/>
            <Button Content="Filter"
                Command="{Binding FilterCommand}"
                Width="100"
                Height="36"
                Margin="12 0 0 0"
                Background="#F3F4F6"
                BorderBrush="#D1D5DB" />
        </StackPanel>

        <!-- Hàng 4: Employee Cards -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredEmployees}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True" HorizontalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Width="280" Height="220" Margin="8">
                            <StackPanel Margin="12">

                                <!-- Header: Avatar + Name + Position + Status -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" >
                                    <Ellipse Width="36" Height="36" Fill="#E0E7FF"/>
                                    <StackPanel Margin="8 0 10 0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Position}" FontSize="12" Foreground="#6B7280"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Status}" FontSize="12"
                                           Foreground="{Binding StatusColor}"
                                           HorizontalAlignment="Right"
                                           Margin="0 0 0 0"/>
                                </StackPanel>

                                <!-- Contact + Department -->
                                <StackPanel Margin="0 12 0 0">
                                    <StackPanel Orientation="Horizontal" Margin="0 2 0 0">
                                        <TextBlock Text="✉ " FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock Text="{Binding Email}" FontSize="12" Foreground="#6B7280"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0 2 0 0">
                                        <TextBlock Text="📞 " FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock Text="{Binding Phone}" FontSize="12" Foreground="#6B7280"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0 2 0 0">
                                        <TextBlock Text="📁 " FontSize="12" Foreground="#FBBF24"/>
                                        <TextBlock Text="{Binding Department}" FontSize="12" Foreground="#FBBF24"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0 12 0 0">
                                    <Button Content="Chỉnh sửa" Style="{StaticResource BlueButton}" Width="160" Height="32"
                                        Command="{Binding DataContext.EditEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                    <Button Content="🗑" Background="#FEE2E2" Foreground="#B91C1C" Width="32" Height="32" Margin="8 0 0 0"
                                        Command="{Binding DataContext.DeleteEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
