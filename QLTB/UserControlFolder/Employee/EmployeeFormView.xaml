<UserControl x:Class="QLTB.UserControlFolder.Employee.EmployeeFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QLTB.UserControlFolder.Employee"
             mc:Ignorable="d" 
             Background="Transparent">

    <Border Width="650"
            Background="White"
            CornerRadius="16"
            Padding="25"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Opacity="0.1"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="Nhân viên" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="#111827" 
                       Margin="0,0,0,25"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Họ và tên" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                    <TextBox Style="{StaticResource RoundedTextBox}" 
                             Height="42" 
                             Padding="12,0" 
                             VerticalContentAlignment="Center" 
                             Tag="Nhập họ và tên" 
                             Text="{Binding FullName}"/>

                    <TextBlock Text="Số điện thoại" FontWeight="SemiBold" Margin="0,20,0,8" Foreground="#374151"/>
                    <TextBox Style="{StaticResource RoundedTextBox}" 
                             Height="42" 
                             Padding="12,0" 
                             VerticalContentAlignment="Center" 
                             Tag="Nhập số điện thoại" 
                             Text="{Binding Phone}"/>

                    <TextBlock Text="Phòng ban" FontWeight="SemiBold" Margin="0,20,0,8" Foreground="#374151"/>
                    <ComboBox Style="{StaticResource ModernComboBox}" 
                              Height="42" 
                              SelectedIndex="0"
                              ItemsSource="{Binding Departments}"
                              SelectedItem="{Binding SelectedDepartment}">
                        <ComboBoxItem Content="Bảo trì"/>
                        <ComboBoxItem Content="Kỹ thuật"/>
                        <ComboBoxItem Content="Vận hành"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                    <TextBox Style="{StaticResource RoundedTextBox}" 
                             Height="42" 
                             Padding="12,0" 
                             VerticalContentAlignment="Center" 
                             Tag="Nhập địa chỉ email" 
                             Text="{Binding Email}"/>

                    <TextBlock Text="Vai trò" FontWeight="SemiBold" Margin="0,20,0,8" Foreground="#374151"/>
                    <ComboBox Style="{StaticResource ModernComboBox}" 
                              Height="42" 
                              SelectedIndex="0"
                              BorderBrush="#2563EB"
                              ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding SelectedRole}">
                        <ComboBoxItem Content="Kỹ thuật viên"/>
                        <ComboBoxItem Content="Quản lý"/>
                        <ComboBoxItem Content="Nhân viên"/>
                    </ComboBox>

                    <TextBlock Text="Trạng thái" FontWeight="SemiBold" Margin="0,20,0,8" Foreground="#374151"/>
                    <ComboBox Style="{StaticResource ModernComboBox}" 
                              Height="42" 
                              SelectedIndex="0"
                              ItemsSource="{Binding Statuses}"
                              SelectedItem="{Binding SelectedStatus}">
                        <ComboBoxItem Content="Đang hoạt động"/>
                        <ComboBoxItem Content="Ngưng hoạt động"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
                <Button Content="Hủy bỏ" 
                        Width="100" 
                        Height="42" 
                        Background="White" 
                        BorderBrush="#D1D5DB" 
                        BorderThickness="1" 
                        Margin="0,0,12,0" 
                        Cursor="Hand" 
                        Command="{Binding CancelCommand}"/>

                <Button Content="Lưu nhân viên" 
                        Width="150" 
                        Height="42" 
                        Background="#2563EB" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        BorderThickness="0" 
                        Cursor="Hand" 
                        Command="{Binding AddEmployeeCommand}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>