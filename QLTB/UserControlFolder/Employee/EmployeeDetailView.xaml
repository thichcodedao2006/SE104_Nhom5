<UserControl x:Class="QLTB.UserControlFolder.Employee.EmployeeDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QLTB.UserControlFolder.Employee"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             mc:Ignorable="d" 
             x:Name="thisUC"
             Background="Transparent">

    <Border Width="850"
            Background="{StaticResource MainBackgroundBrush}"
            CornerRadius="16"
            Padding="25"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Opacity="0.1"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="Thông tin nhân viên" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="#111827" 
                       Margin="0,0,0,20"
                       HorizontalAlignment="Center"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Ảnh đại diện" 
               HorizontalAlignment="Center"
               FontWeight="SemiBold" 
               Margin="0,0,0,8" 
               Foreground="#374151"/>

                    <Border Height="250" 
            BorderBrush="#D1D5DB" 
            BorderThickness="1.5" 
            CornerRadius="10" 
            Background="#F9FAFB"
            ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="Chưa cập nhật ảnh" 
                       Foreground="#9CA3AF" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Padding="10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Data.CurrentAvatar}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Data.CurrentAvatar}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Image Source="{Binding Data.CurrentAvatar, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Stretch="Fill">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Data.CurrentAvatar}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Data.CurrentAvatar}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Grid>
                    </Border>

                    <Button Content="Xác thực tài khoản" 
            Margin="0,16,0,0" 
            Height="42" 
            Foreground="White" 
            FontWeight="SemiBold" 
            Cursor="Hand"
            Command="{Binding XacThucTaiKhoanCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#EF4444"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#DC2626"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2">

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mã nhân viên" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                            <TextBox IsReadOnly="True"
                 Text="{Binding Data.Id, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                 Background="#F3F4F6" 
                 Foreground="#6B7280"
                 BorderBrush="#E5E7EB"
                 Height="42"
                 Padding="12,0"
                 VerticalContentAlignment="Center"
                 Style="{StaticResource RoundedTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Họ và tên" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                            <TextBox IsReadOnly="True"
                 Text="{Binding Data.HoTen, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                 Background="#F3F4F6" 
                 Foreground="#6B7280"
                 BorderBrush="#E5E7EB"
                 Height="42"
                 Padding="12,0"
                 VerticalContentAlignment="Center"
                 Style="{StaticResource RoundedTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Số điện thoại" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                            <TextBox Style="{StaticResource RoundedTextBox}" 
                 Text="{Binding Data.Sdt, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 Height="42" Padding="12,0" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                            <TextBox IsReadOnly="True"
                 Text="{Binding Data.Email, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                 Background="#F3F4F6" 
                 Foreground="#6B7280"
                 BorderBrush="#E5E7EB"
                 Height="42" 
                 Padding="12,0" 
                 VerticalContentAlignment="Center"
                 Style="{StaticResource RoundedTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Bộ phận" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                      Height="42" 
                                      ItemsSource="{Binding ListBoPhan}"
                                      DisplayMemberPath="TenBoPhan"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedBoPhan, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Chức danh" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                      Height="42" 
                                      ItemsSource="{Binding ListChucDanh}"
                                      DisplayMemberPath="TenChucDanh"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedChucDanh, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Chuyên môn" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                            <TextBox 
                                IsReadOnly="true"
                                Style="{StaticResource RoundedTextBox}" 
                                     Text="{Binding ChuyenMon, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     Height="42" Padding="12,0" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Loại tài khoản" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#374151"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" 
                                      Height="42" 
                                      ItemsSource="{Binding ListLoaiTaiKhoan}"
                                      DisplayMemberPath="TenLoaiTaiKhoan"
                                      SelectedValuePath="LoaiTaiKhoan"
                                      SelectedValue="{Binding SelectedLoaiTaiKhoan, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">

                <Button Content="Đóng" 
                        Width="100" 
                        Height="42" 
                        Background="White" 
                        BorderBrush="#D1D5DB" 
                        BorderThickness="1" 
                        Margin="0,0,12,0" 
                        Cursor="Hand" 
                        Command="{Binding CloseForm}"
                        CommandParameter="{Binding ElementName=thisUC}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Lưu" 
                        Width="120" 
                        Height="42" 
                        Background="#2563EB" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        BorderThickness="0" 
                        Cursor="Hand" 
                        Command="{Binding SaveInfoCommand}"
                        CommandParameter="{Binding ElementName=thisUC}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>